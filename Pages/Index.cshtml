@page

@functions {
    public void OnGet()
    {
    }
}
@{
    ViewData["Title"] = "Home";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FinTrack - Suas finanças no controle</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        /* Bootstrap com a identidade do FinTrack (mesmas variáveis do _LayoutAcesso) */
        :root {
            --bs-primary: #059669;
            --bs-primary-rgb: 5, 150, 105;
            --bs-body-font-family: 'Plus Jakarta Sans', sans-serif;
            --bs-body-color: #1f2937;
            --bs-body-bg: #f9fafb;
            --bs-border-radius: .75rem;
            --bs-border-radius-lg: 1rem;
            --bs-border-radius-xl: 1.5rem;
        }

        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }

        /* ---- Seu CSS original, sem alteração ---- */
        .hero-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f4c3a 100%);
        }

        .card-hover {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .card-hover:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 40px rgba(0,0,0,0.12);
        }

        .feature-icon {
            width: 56px;
            height: 56px;
            object-fit: contain;
            opacity: 1;
        }

        .cta-gradient {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
        }

        .fade-in {
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 0.6s ease forwards;
            will-change: transform;
        }

        .fade-in-delay-1 { animation-delay: 0.1s; }
        .fade-in-delay-2 { animation-delay: 0.2s; }
        .fade-in-delay-3 { animation-delay: 0.3s; }
        .fade-in-delay-4 { animation-delay: 0.4s; }
        .fade-in-delay-5 { animation-delay: 0.5s; }

        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .glow {
            box-shadow: 0 0 60px rgba(16, 185, 129, 0.15);
        }

        /* ---- O que era utilitário do Tailwind e virou CSS comum ---- */
        .header-blur {
            background: rgba(255, 255, 255, .90);
            backdrop-filter: blur(8px);
            -webkit-backdrop-filter: blur(8px);
        }

        /* Antes: w-1.5 h-1.5 bg-emerald-500 rounded-full */
        .dot {
            display: inline-block;
            width: .375rem;
            height: .375rem;
            background: #10b981;
            border-radius: 50%;
            flex-shrink: 0;
        }

        .text-emerald { color: #34d399; }

        .logo-header { width: 2.5rem; height: 2.5rem; }
        .logo-hero { width: 6rem; height: 6rem; }

        .btn-cta {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            color: #fff;
            border: none;
            transition: opacity .2s;
        }
        .btn-cta:hover { opacity: .9; color: #fff; }

        .btn-outline-hero {
            border: 1px solid #6b7280;
            color: #d1d5db;
            transition: background-color .2s;
        }
        .btn-outline-hero:hover { background: rgba(255, 255, 255, .1); color: #fff; }

        /* Compensa a altura do header fixo ao pular pra #funcionalidades */
        #funcionalidades { scroll-margin-top: 5rem; }
    </style>
</head>
<body>

    <!-- Header -->
    <header class="fixed-top header-blur border-bottom">
        <div class="container d-flex align-items-center justify-content-between py-3">
            <div class="d-flex align-items-center gap-2">
                <img src="~/images/carteira.png" alt="FinTrack" class="logo-header" />
                <span class="font-display fs-3 fw-bold text-dark">FinTrack</span>
            </div>
            <div class="d-flex align-items-center gap-2">
                <a asp-page="/ControleAcesso/Index" class="btn btn-link text-secondary fw-medium text-decoration-none">
                    Entrar
                </a>
                <a asp-page="/ControleAcesso/Registro" class="btn btn-success fw-medium px-3"
                   style="background-color: #059669; border-color: #059669;">
                    Criar Conta
                </a>
            </div>
        </div>
    </header>

    <!-- Hero -->
    <section class="hero-gradient min-vh-100 d-flex align-items-center justify-content-center text-white pt-5">
        <div class="container text-center" style="max-width: 56rem;">
            <div class="fade-in">
                <img src="~/images/carteira.png" alt="" class="logo-hero d-block mx-auto mb-4" />
            </div>
            <h1 class="font-display display-2 fw-bold mb-4 fade-in fade-in-delay-1 lh-1">
                Suas finanças<br>
                <span class="text-emerald">no controle.</span>
            </h1>
            <p class="fs-4 text-white-50 mb-5 mx-auto fade-in fade-in-delay-2" style="max-width: 42rem;">
                Organize receitas, despesas e investimentos em um só lugar. Simples, visual e sem complicação.
            </p>
            <div class="d-flex flex-column flex-sm-row gap-3 justify-content-center fade-in fade-in-delay-3">
                <a asp-page="/ControleAcesso/Registro" class="btn btn-cta btn-lg px-4 py-3 fw-semibold">
                    Começar Agora
                </a>
                <a href="#funcionalidades" class="btn btn-outline-hero btn-lg px-4 py-3 fw-semibold">
                    Ver Funcionalidades
                </a>
            </div>
        </div>
    </section>

    <!-- Funcionalidades -->
    <section id="funcionalidades" class="py-5 my-5">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="font-display display-5 fw-bold text-dark mb-3">
                    Tudo que você precisa
                </h2>
                <p class="fs-5 text-secondary mx-auto" style="max-width: 36rem;">
                    Do controle diário ao planejamento de longo prazo, o FinTrack cobre todas as suas necessidades financeiras.
                </p>
            </div>

            <!-- Antes: grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 -->
            <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">

                <!-- Controle Financeiro -->
                <div class="col">
                    <div class="card h-100 card-hover border-light-subtle rounded-4 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/images/carteira.png" alt="" class="feature-icon" />
                            <h3 class="font-display fs-5 fw-bold text-dark mb-0">Controle Financeiro</h3>
                        </div>
                        <p class="text-secondary mb-3">
                            Registre suas receitas e despesas com facilidade. Categorize cada transação e tenha uma visão clara de onde seu dinheiro está indo.
                        </p>
                        <ul class="list-unstyled small text-body-secondary mb-0 d-grid gap-2">
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Receitas e despesas</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Categorias personalizáveis</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Orçamento mensal com metas</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Gastos recorrentes e assinaturas</li>
                        </ul>
                    </div>
                </div>

                <!-- Cartões e Parcelas -->
                <div class="col">
                    <div class="card h-100 card-hover border-light-subtle rounded-4 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/images/cartao.png" alt="" class="feature-icon" />
                            <h3 class="font-display fs-5 fw-bold text-dark mb-0">Cartões e Parcelas</h3>
                        </div>
                        <p class="text-secondary mb-3">
                            Gerencie seus cartões de crédito, acompanhe faturas e controle compras parceladas sem perder nenhuma parcela.
                        </p>
                        <ul class="list-unstyled small text-body-secondary mb-0 d-grid gap-2">
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Cadastro de cartões com limite</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Controle de fatura</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Acompanhamento de parcelas</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Impacto nas faturas futuras</li>
                        </ul>
                    </div>
                </div>

                <!-- Investimentos e Metas -->
                <div class="col">
                    <div class="card h-100 card-hover border-light-subtle rounded-4 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/images/moedas.png" alt="" class="feature-icon" />
                            <h3 class="font-display fs-5 fw-bold text-dark mb-0">Investimentos e Metas</h3>
                        </div>
                        <p class="text-secondary mb-3">
                            Acompanhe seus investimentos, defina metas de economia e planeje sua liberdade financeira.
                        </p>
                        <ul class="list-unstyled small text-body-secondary mb-0 d-grid gap-2">
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Registro de investimentos</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Metas de economia com progresso</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Simulador de liberdade financeira</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Rentabilidade por aplicação</li>
                        </ul>
                    </div>
                </div>

                <!-- Simuladores -->
                <div class="col">
                    <div class="card h-100 card-hover border-light-subtle rounded-4 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/images/dinheiro.png" alt="" class="feature-icon" />
                            <h3 class="font-display fs-5 fw-bold text-dark mb-0">Simuladores</h3>
                        </div>
                        <p class="text-secondary mb-3">
                            Ferramentas inteligentes para te ajudar a tomar decisões financeiras melhores no dia a dia.
                        </p>
                        <ul class="list-unstyled small text-body-secondary mb-0 d-grid gap-2">
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Salário-hora</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>À vista vs a prazo</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Comprar vs alugar</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Quanto quero ganhar</li>
                        </ul>
                    </div>
                </div>

                <!-- Relatórios -->
                <div class="col">
                    <div class="card h-100 card-hover border-light-subtle rounded-4 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/images/saco-dinheiro.png" alt="" class="feature-icon" />
                            <h3 class="font-display fs-5 fw-bold text-dark mb-0">Relatórios e Dashboard</h3>
                        </div>
                        <p class="text-secondary mb-3">
                            Visualize sua saúde financeira com gráficos claros, DRE pessoal e comparativos entre períodos.
                        </p>
                        <ul class="list-unstyled small text-body-secondary mb-0 d-grid gap-2">
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Dashboard com gráficos</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>DRE pessoal anual</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Comparativo mensal</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Alertas de gastos excessivos</li>
                        </ul>
                    </div>
                </div>

                <!-- Planejamento -->
                <div class="col">
                    <div class="card h-100 card-hover border-light-subtle rounded-4 p-4">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <img src="~/images/cofre.png" alt="" class="feature-icon" />
                            <h3 class="font-display fs-5 fw-bold text-dark mb-0">Planejamento Futuro</h3>
                        </div>
                        <p class="text-secondary mb-3">
                            Projete seus próximos meses com fluxo de caixa futuro, considerando recorrentes e parcelas.
                        </p>
                        <ul class="list-unstyled small text-body-secondary mb-0 d-grid gap-2">
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Fluxo de caixa futuro</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Projeção com recorrentes</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Tags e etiquetas</li>
                            <li class="d-flex align-items-center gap-2"><span class="dot"></span>Importação de extratos (CSV)</li>
                        </ul>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- CTA Final -->
    <section class="py-5 my-5">
        <div class="container text-center" style="max-width: 48rem;">
            <div class="cta-gradient rounded-4 p-5 glow">
                <h2 class="font-display display-6 fw-bold text-white mb-3">
                    Pronto para organizar suas finanças?
                </h2>
                <p class="fs-5 mb-4 mx-auto" style="max-width: 36rem; color: #d1fae5;">
                    Comece agora e tenha o controle total do seu dinheiro. Gratuito, simples e direto ao ponto.
                </p>
                <a asp-page="/ControleAcesso/Registro"
                   class="btn btn-light btn-lg px-4 py-3 fw-semibold" style="color: #047857;">
                    Criar Minha Conta
                </a>
            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer class="border-top py-4">
        <div class="container text-center text-secondary small">
            <p class="mb-0">&copy; 2026 FinTrack. Feito por Isac Macedo.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
