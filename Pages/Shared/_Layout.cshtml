<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FinTrack</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        /* Mesmas variáveis das outras telas, pra identidade não mudar de página pra página */
        :root {
            --bs-primary: #059669;
            --bs-primary-rgb: 5, 150, 105;
            --bs-body-font-family: 'Plus Jakarta Sans', sans-serif;
            --bs-body-color: #1e293b;
            --bs-border-radius: .75rem;
        }

        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        h1, h2, h3, h4, .font-display { font-family: 'Outfit', sans-serif; }
    </style>
</head>
<body class="d-flex flex-column min-vh-100">

<header>
    <nav class="navbar navbar-expand bg-white border-bottom shadow-sm">
        <div class="container">
            <a class="navbar-brand font-display fs-5 fw-bold text-dark" asp-area="" asp-page="/Index">FinTrack</a>
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" asp-area="" asp-page="/Index">Home</a>
                </li>
            </ul>
        </div>
    </nav>
</header>

<div class="container flex-grow-1">
    <main role="main" class="py-4">
        @RenderBody()
    </main>
</div>

<footer class="border-top text-secondary small py-3">
    <div class="container">
        &copy; 2026 - FinTrack
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
