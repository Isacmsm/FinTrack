@page
@using System.ComponentModel.DataAnnotations
@using FinTrack.Data
@using FinTrack.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject FinTrackDbContext Db
@inject IPasswordHasher<Usuario> Hasher
@functions {

    public class RegistroRequest
    {
        public string Nome { get; set; } = "";
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
    }

    private static readonly EmailAddressAttribute ValidadorDeEmail = new();

    /// <summary>
    /// Equivale ao LIKE '%_@_%.__%' da procedure: exige formato de e-mail e um
    /// ponto no domínio. Usa o validador da própria plataforma em vez de regex.
    /// </summary>
    private static bool EmailValido(string email)
    {
        if (!ValidadorDeEmail.IsValid(email)) return false;

        var dominio = email[(email.LastIndexOf('@') + 1)..];
        return dominio.Contains('.') && dominio.Split('.')[^1].Length >= 2;
    }

    // As mesmas regras que estavam na procedure FT_Usuario_Ins, agora em C#.
    private static void Validar(RegistroRequest r)
    {
        var nome = r.Nome?.Trim() ?? "";
        var email = r.Email?.Trim() ?? "";
        var senha = r.Senha ?? "";

        new Validador()
            .Exigir(nome.Length > 0, "nome", "Informe o nome do usuário")
            .Exigir(nome.Length == 0 || nome.Length >= 3, "nome", "O nome deve ter pelo menos 3 caracteres")
            .Exigir(email.Length > 0, "email", "Informe o e-mail")
            .Exigir(email.Length == 0 || EmailValido(email), "email", "Informe um e-mail válido")
            .Exigir(senha.Length > 0, "senha", "Informe a senha")
            .Exigir(senha.Length == 0 || senha.Length >= 6, "senha", "A senha deve ter pelo menos 6 caracteres")
            .LancarSeInvalido();
    }

    public Task<IActionResult> OnPostRegistroAsync([FromBody] RegistroRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            Validar(request);

            var email = request.Email.Trim();

            // Antes: IF EXISTS(SELECT Id FROM Usuario WHERE Email = @Email)
            if (await Db.Usuarios.AnyAsync(u => u.Email == email))
            {
                throw new ErroDeNegocioException("Operação cancelada. Já existe um usuário cadastrado com este e-mail");
            }

            var usuario = new Usuario
            {
                Nome = request.Nome.Trim(),
                Email = email
            };

            // A senha NUNCA vai em texto puro pro banco. O PasswordHasher gera
            // um salt aleatório por usuário e aplica PBKDF2.
            usuario.Senha = Hasher.HashPassword(usuario, request.Senha);

            Db.Usuarios.Add(usuario);
            await Db.SaveChangesAsync();

            return new JsonResult(new { sucesso = true }) { StatusCode = 200 };
        });
    }
}
@{
    ViewData["Title"] = "Registro";
    
}

<div class="painel-login d-flex align-items-center justify-content-center p-4 p-md-5 position-relative">
    <div class="card-glass rounded-4 shadow-lg p-4 p-md-5 w-100 fade-in" style="max-width: 28rem;">

        <div class="text-center mb-4 fade-in fade-in-delay-1">
            <img src="~/images/carteira.png" alt="FinTrack" class="logo-login d-block mx-auto mb-3"/>
            <h1 class="font-display fs-2 fw-bold text-dark mb-0">FinTrack</h1>
            <p class="text-secondary small mt-1 mb-0">Suas finanças no controle</p>
        </div>

        <div class="mb-4 fade-in fade-in-delay-2">
            <h2 class="font-display fs-5 fw-semibold text-dark mb-0">Crie sua conta</h2>
            <p class="text-secondary small mt-1 mb-0">Seu controle financeiro começa agora</p>
        </div>

        <!-- Formulário -->
        <div class="fade-in fade-in-delay-3" id="formRegistro">

            @Html.AntiForgeryToken()

            <!-- Nome -->
            <div class="mb-3">
                <label for="nome" class="form-label small fw-medium text-dark">Nome Completo</label>
                <input
                    type="text"
                    id="nome"
                    name="nome"
                    placeholder="João Ninguém"
                    class="form-control form-control-lg"
                />
                <span class="erro-input text-danger small d-none" id="erroNome"></span>
            </div>

            <!-- E-mail -->
            <div class="mb-3">
                <label for="email" class="form-label small fw-medium text-dark">E-mail</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="seu@@email.com"
                    class="form-control form-control-lg"
                />
                <span class="erro-input text-danger small d-none" id="erroEmail"></span>
            </div>

            <!-- Senha -->
            <div class="mb-3">
                <label for="senha" class="form-label small fw-medium text-dark">Senha</label>
                <div class="position-relative">
                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        placeholder="••••••••"
                        class="form-control form-control-lg pe-5"
                    />
                    <button type="button" class="btn-olho" onclick="toggleSenha()">
                        <svg id="iconOlho" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                    </button>
                </div>
                <span class="erro-input text-danger small d-none" id="erroSenha"></span>
            </div>

            <!-- Erro geral -->
            <div class="alert alert-danger py-2 px-3 small d-none" id="erroGeral"></div>

            <!-- Botão Registro -->
            <button type="button" class="btn btn-login w-100 fw-semibold py-3" id="btnRegistro" onclick="fazerRegistro()">
                Registrar
            </button>

            <!-- Divisor -->
            <div class="divider text-secondary small my-3">ou</div>

            <!-- Link Login -->
            <div class="text-center">
                <p class="text-secondary small mb-0">
                    Já tem uma conta?
                    <a asp-page="/ControleAcesso/Index" class="fw-semibold text-decoration-none" style="color: #059669;">
                        Entre na sua conta
                    </a>
                </p>
            </div>
        </div>
    </div>
</div>
@section Scripts {
<script>
    function fazerRegistro(){
        limparErros();
        
        const nome = $('#nome').val();
        const email = $('#email').val();
        const senha = $('#senha').val();
        
        $('#btnRegistro').prop('disabled', true).text('Registrando...');
        
        $.ajax({
            url: '/ControleAcesso/Registro?handler=Registro',
            type: 'POST',
            contentType: 'application/json',
            headers: {
                'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
            },
            data: JSON.stringify({nome: nome, email: email, senha: senha}),
            success: function (data) {
                if (data.sucesso) {
                    window.location.href = '/ControleAcesso';
                }
            },
            error: function (xhr) {
                $('#btnRegistro').prop('disabled', false).text('Registrar');
                mostrarErros(xhr);
            }
        });
    }

    function toggleSenha() {
        const input = document.getElementById('senha');
        const icon = document.getElementById('iconOlho');

        if (input.type === 'password') {
            input.type = 'text';
            icon.innerHTML = `
                    <path d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                `;
        } else {
            input.type = 'password';
            icon.innerHTML = `
                    <path d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                    <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                `;
        }
    }

    // Enter para registrar
    $(document).on('keypress', '#nome, #email, #senha', function (e) {
        if (e.which === 13) {
            fazerRegistro();
        }
    });
</script>
}
