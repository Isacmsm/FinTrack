<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - FinTrack</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"/>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600&display=swap"
        rel="stylesheet">

    <style>
        /* ============================================================
           1. Bootstrap adaptado ao FinTrack.
           O Bootstrap 5.3 é feito de variáveis CSS, então dá pra trocar
           a cara dele sem recompilar nada. É isto que evita o site ficar
           com "cara de Bootstrap padrão".
           ============================================================ */
        :root {
            --bs-primary: #059669;
            --bs-primary-rgb: 5, 150, 105;
            --bs-body-font-family: 'Plus Jakarta Sans', sans-serif;
            --bs-body-color: #1e293b;
            --bs-border-color: #e2e8f0;
            --bs-border-radius: .75rem;
            --bs-border-radius-lg: 1rem;
            --bs-border-radius-xl: 1.5rem;
        }

        /* Foco verde nos campos, no lugar do azul padrão do Bootstrap.
           Substitui a sua antiga classe .input-focus. */
        .form-control:focus {
            border-color: #10b981;
            box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
        }

        .form-control::placeholder {
            color: #cbd5e1;
        }

        .text-emerald {
            color: #34d399;
        }

        /* ============================================================
           2. Daqui pra baixo é o SEU CSS original, sem alteração.
           Nada disto dependia do Tailwind.
           ============================================================ */
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        h1, h2, h3, h4, .font-display {
            font-family: 'Outfit', sans-serif;
        }

        .hero-gradient {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f4c3a 100%);
        }

        .card-glass {
            background: rgba(255, 255, 255, 0.92);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
        }

        .btn-login {
            background: linear-gradient(135deg, #059669 0%, #047857 100%);
            transition: all 0.3s ease;
            border: none;
            color: #fff;
        }

        .btn-login:hover {
            transform: translateY(-1px);
            box-shadow: 0 4px 20px rgba(5, 150, 105, 0.4);
            color: #fff;
        }

        .fade-in {
            opacity: 0;
            transform: translateY(16px);
            animation: fadeInUp 0.5s ease forwards;
        }

        .fade-in-delay-1 {
            animation-delay: 0.1s;
        }

        .fade-in-delay-2 {
            animation-delay: 0.2s;
        }

        .fade-in-delay-3 {
            animation-delay: 0.3s;
        }

        @@keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .floating {
            animation: float 6s ease-in-out infinite;
            /* Promove o elemento a uma camada própria na GPU. Sem isto o
               navegador redesenha a imagem (2000x2000) a cada quadro. */
            will-change: transform;
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }
            50% {
                transform: translateY(-10px);
            }
        }

        .divider {
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .divider::before, .divider::after {
            content: '';
            flex: 1;
            height: 1px;
            background: #e2e8f0;
        }

        /* ============================================================
           3. O que antes eram utilitários do Tailwind e o Bootstrap não
           tem equivalente (blur, tamanhos fixos). Virou CSS comum.
           Antes: w-72 h-72 bg-emerald-500/10 rounded-full blur-3xl
           ============================================================ */
        .painel-login {
            width: 100%;
        }

        @@media (min-width: 768px) {
            .painel-login {
                width: 480px;
            }
        }

        .blob {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
            /* Os blobs são estáticos, mas o blur é caro. Isolando em camada
               própria, eles não são recalculados quando a imagem anima. */
            transform: translateZ(0);
        }

        .blob-1 {
            top: 5rem;
            right: 5rem;
            width: 18rem;
            height: 18rem;
            background: rgba(16, 185, 129, 0.10);
            filter: blur(64px);
        }

        .blob-2 {
            bottom: 5rem;
            left: 5rem;
            width: 24rem;
            height: 24rem;
            background: rgba(52, 211, 153, 0.05);
            filter: blur(64px);
        }

        .blob-3 {
            top: 33%;
            right: 33%;
            width: 12rem;
            height: 12rem;
            background: rgba(20, 184, 166, 0.10);
            filter: blur(40px);
        }

        .feature-icon {
            width: 2.5rem;
            height: 2.5rem;
            background: rgba(255, 255, 255, 0.10);
            border-radius: 0.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0 auto 0.5rem;
        }

        .logo-login {
            width: 4rem;
            height: 4rem;
        }

        .logo-hero {
            width: 7rem;
            height: 7rem;
        }

        .btn-olho {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            padding: 0;
            color: #94a3b8;
            transition: color 0.2s;
        }

        .btn-olho:hover {
            color: #475569;
        }
    </style>
</head>
<body class="hero-gradient">

<div class="d-flex min-vh-100">

    @RenderBody()

    <!-- Área direita (decorativa) — d-none d-md-flex = escondida no celular -->
    <div class="d-none d-md-flex flex-fill align-items-center justify-content-center position-relative overflow-hidden">

        <div class="blob blob-1"></div>
        <div class="blob blob-2"></div>
        <div class="blob blob-3"></div>

        <div class="text-center position-relative px-4" style="max-width: 32rem;">
            <img src="~/images/carteira.png" alt="" class="logo-hero d-block mx-auto mb-4 floating"/>

            <h2 class="font-display display-5 fw-bold text-white mb-3 lh-sm">
                Organize suas<br>finanças com<br>
                <span class="text-emerald">simplicidade.</span>
            </h2>

            <p class="text-white-50 fs-5">
                Controle receitas, despesas, investimentos e dívidas em um só lugar.
            </p>

            <!-- Antes: grid grid-cols-3 gap-6 | Agora: row + col-4 do Bootstrap -->
            <div class="row mt-5 g-3">
                <div class="col-4">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="text-emerald" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/>
                        </svg>
                    </div>
                    <span class="text-white-50 small">Relatórios</span>
                </div>
                <div class="col-4">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="text-emerald" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"/>
                        </svg>
                    </div>
                    <span class="text-white-50 small">Seguro</span>
                </div>
                <div class="col-4">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" class="text-emerald" fill="none"
                             viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round"
                                  d="M2.25 18.75a60.07 60.07 0 0 1 15.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 0 1 3 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 0 0-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 0 1-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 0 0 3 15h-.75M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Zm3 0h.008v.008H18V10.5Zm-12 0h.008v.008H6V10.5Z"/>
                        </svg>
                    </div>
                    <span class="text-white-50 small">Gratuito</span>
                </div>
            </div>
        </div>
    </div>

</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
