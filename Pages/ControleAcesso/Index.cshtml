@page
@using Microsoft.AspNetCore.Http
@using FinTrack.Data
@using FinTrack.Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@inject FinTrackDbContext Db
@inject IPasswordHasher<Usuario> Hasher
@functions {

    public class LoginRequest
    {
        public string Email { get; set; } = "";
        public string Senha { get; set; } = "";
    }

    private void SalvarSessao(Usuario usuario)
    {
        HttpContext.Session.SetInt32("IdUser", usuario.Id);
        HttpContext.Session.SetString("NomeUser", usuario.Nome);
        HttpContext.Session.SetString("EmailUser", usuario.Email);
    }

    /// <summary>
    /// Confere a senha. Trata o caso das contas antigas, que foram gravadas em
    /// texto puro antes da migração — nesse caso valida por comparação direta e
    /// devolve true em <paramref name="precisaMigrar"/> para regravar com hash.
    /// </summary>
    private bool SenhaConfere(Usuario usuario, string senhaDigitada, out bool precisaMigrar)
    {
        precisaMigrar = false;

        try
        {
            var r = Hasher.VerifyHashedPassword(usuario, usuario.Senha, senhaDigitada);

            if (r == PasswordVerificationResult.Success) return true;

            if (r == PasswordVerificationResult.SuccessRehashNeeded)
            {
                precisaMigrar = true;
                return true;
            }
        }
        catch (FormatException)
        {
            // Senha antiga em texto puro não é base64 válido: o verificador
            // estoura em vez de retornar Failed. Cai no fallback abaixo.
        }

        if (usuario.Senha == senhaDigitada)
        {
            precisaMigrar = true;
            return true;
        }

        return false;
    }

    public Task<IActionResult> OnPostLoginAsync([FromBody] LoginRequest request)
    {
        return Util.ExecutarHandlerAsync(async () =>
        {
            var email = request.Email?.Trim() ?? "";

            // Mesmas validações da procedure FT_Usuario_Login.
            new Validador()
                .Exigir(email.Length > 0, "email", "Informe o e-mail")
                .Exigir(!string.IsNullOrWhiteSpace(request.Senha), "senha", "Informe a senha")
                .LancarSeInvalido();

            var usuario = await Db.Usuarios.FirstOrDefaultAsync(u => u.Email == email);

            // Mensagem genérica de propósito: dizer "e-mail não existe" entrega
            // a quem está tentando adivinhar quais contas existem.
            if (usuario is null || !SenhaConfere(usuario, request.Senha, out var precisaMigrar))
            {
                throw new Exception("E-mail ou senha incorretos");
            }

            if (precisaMigrar)
            {
                usuario.Senha = Hasher.HashPassword(usuario, request.Senha);
                await Db.SaveChangesAsync();
            }

            SalvarSessao(usuario);
            return new JsonResult(new { sucesso = true }) { StatusCode = 200 };
        });
    }
}
@{
    ViewData["Title"] = "Login";
}

<!-- Card de Login (esquerda) -->
<div class="painel-login d-flex align-items-center justify-content-center p-4 p-md-5 position-relative">
    <div class="card-glass rounded-4 shadow-lg p-4 p-md-5 w-100 fade-in" style="max-width: 28rem;">

        <!-- Logo -->
        <div class="text-center mb-4 fade-in fade-in-delay-1">
            <img src="~/images/carteira.png" alt="FinTrack" class="logo-login d-block mx-auto mb-3"/>
            <h1 class="font-display fs-2 fw-bold text-dark mb-0">FinTrack</h1>
            <p class="text-secondary small mt-1 mb-0">Suas finanças no controle</p>
        </div>

        <!-- Mensagem de boas-vindas -->
        <div class="mb-4 fade-in fade-in-delay-2">
            <h2 class="font-display fs-5 fw-semibold text-dark mb-0">Bem-vindo de volta</h2>
            <p class="text-secondary small mt-1 mb-0">Entre na sua conta para continuar</p>
        </div>

        <!-- Formulário -->
        <div class="fade-in fade-in-delay-3" id="formLogin">

            @Html.AntiForgeryToken()

            <!-- E-mail -->
            <div class="mb-3">
                <label for="email" class="form-label small fw-medium text-dark">E-mail</label>
                <input
                    type="email"
                    id="email"
                    name="email"
                    placeholder="seu@@email.com"
                    class="form-control form-control-lg"
                />
                <span class="erro-input text-danger small d-none" id="erroEmail"></span>
            </div>

            <!-- Senha -->
            <div class="mb-3">
                <label for="senha" class="form-label small fw-medium text-dark">Senha</label>
                <div class="position-relative">
                    <input
                        type="password"
                        id="senha"
                        name="senha"
                        placeholder="••••••••"
                        class="form-control form-control-lg pe-5"
                    />
                    <button type="button" class="btn-olho" onclick="toggleSenha()">
                        <svg id="iconOlho" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                            <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                        </svg>
                    </button>
                </div>
                <span class="erro-input text-danger small d-none" id="erroSenha"></span>
            </div>

            <!-- Erro geral: agora é o componente alert do Bootstrap -->
            <div class="alert alert-danger py-2 px-3 small d-none" id="erroGeral"></div>

            <!-- Botão Login -->
            <button type="button" class="btn btn-login w-100 fw-semibold py-3" id="btnLogin" onclick="fazerLogin()">
                Entrar
            </button>

            <!-- Divisor -->
            <div class="divider text-secondary small my-3">ou</div>

            <!-- Link Registro -->
            <div class="text-center">
                <p class="text-secondary small mb-0">
                    Não tem uma conta?
                    <a asp-page="/ControleAcesso/Registro" class="fw-semibold text-decoration-none" style="color: #059669;">
                        Criar conta
                    </a>
                </p>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        function toggleSenha() {
            const input = document.getElementById('senha');
            const icon = document.getElementById('iconOlho');

            if (input.type === 'password') {
                input.type = 'text';
                icon.innerHTML = `
                    <path d="M3.98 8.223A10.477 10.477 0 0 0 1.934 12C3.226 16.338 7.244 19.5 12 19.5c.993 0 1.953-.138 2.863-.395M6.228 6.228A10.451 10.451 0 0 1 12 4.5c4.756 0 8.773 3.162 10.065 7.498a10.522 10.522 0 0 1-4.293 5.774M6.228 6.228 3 3m3.228 3.228 3.65 3.65m7.894 7.894L21 21m-3.228-3.228-3.65-3.65m0 0a3 3 0 1 0-4.243-4.243m4.242 4.242L9.88 9.88" />
                `;
            } else {
                input.type = 'password';
                icon.innerHTML = `
                    <path d="M2.036 12.322a1.012 1.012 0 0 1 0-.639C3.423 7.51 7.36 4.5 12 4.5c4.638 0 8.573 3.007 9.963 7.178.07.207.07.431 0 .639C20.577 16.49 16.64 19.5 12 19.5c-4.638 0-8.573-3.007-9.963-7.178Z" />
                    <path d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                `;
            }
        }

        function fazerLogin() {
            // Limpa erros anteriores
            limparErros();

            const email = $('#email').val();
            const senha = $('#senha').val();

            $('#btnLogin').prop('disabled', true).text('Entrando...');

            $.ajax({
                url: '/ControleAcesso?handler=Login',
                type: 'POST',
                contentType: 'application/json',
                headers: {
                    'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                },
                data: JSON.stringify({ email: email, senha: senha }),
                success: function (response) {
                    if (response.sucesso) {
                        window.location.href = '/App';
                    }
                },
                error: function (xhr) {
                    $('#btnLogin').prop('disabled', false).text('Entrar');

                    mostrarErros(xhr);
                }
            });
        }

        // Enter para fazer login
        $(document).on('keypress', '#email, #senha', function (e) {
            if (e.which === 13) {
                fazerLogin();
            }
        });
    </script>
}
