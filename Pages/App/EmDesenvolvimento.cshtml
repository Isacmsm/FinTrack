@page
@functions {
    public string Nome { get; set; } = "Essa funcionalidade";

    public void OnGet(string? nome)
    {
        if (!string.IsNullOrWhiteSpace(nome)) Nome = nome;
    }
}

<style>
    .em-dev-hero {
        background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f4c3a 100%);
        border-radius: 1rem;
        /* preenche o que sobra de .app-main (100vh) descontando o padding-top
           do header (4rem) e o padding vertical do wrapper .p-4 (3rem) */
        min-height: calc(100vh - 7rem);
    }

    .em-dev-card {
        background: rgba(255, 255, 255, 0.92);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border-radius: 1rem;
        padding: 3rem 2.5rem;
        max-width: 26rem;
    }

    .em-dev-icone {
        width: 4rem;
        height: 4rem;
        border-radius: 50%;
        background: linear-gradient(135deg, #059669 0%, #047857 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 1.75rem;
        animation: em-dev-float 6s ease-in-out infinite;
    }

    @@keyframes em-dev-float {
        0%, 100% { transform: translateY(0); }
        50% { transform: translateY(-8px); }
    }
</style>

<div class="em-dev-hero d-flex align-items-center justify-content-center p-4">
    <div class="em-dev-card text-center d-flex flex-column align-items-center">
        <div class="em-dev-icone mb-4">
            <i class="bi bi-cone-striped"></i>
        </div>
        <h4 class="mb-2">@Nome está em desenvolvimento</h4>
        <p class="text-secondary mb-0">Essa página ainda não foi implementada. Volte em breve.</p>
    </div>
</div>
