@page
@using System.Globalization
@using Microsoft.AspNetCore.Http
@using FinTrack.Data
@using FinTrack.Models
@using Microsoft.EntityFrameworkCore
@inject FinTrackDbContext Db
@functions {

    public List<Recorrente> Recorrentes { get; set; } = [];
    public List<Categoria> Categorias { get; set; } = [];
    public decimal ReceitasRecorrentesMes { get; set; }
    public decimal DespesasRecorrentesMes { get; set; }

    public class RecorrenteRequest
    {
        public int? Id { get; set; }
        public string Descricao { get; set; } = "";
        public decimal? Valor { get; set; }
        public int? DiaVencimento { get; set; }
        public int? IdCategoria { get; set; }
        public bool Ativo { get; set; } = true;
    }

    public class ExcluirRequest
    {
        public int Id { get; set; }
    }

    public class AlternarAtivoRequest
    {
        public int Id { get; set; }
    }

    private int IdUserAtual => HttpContext.Session.GetInt32("IdUser")!.Value;

    public async Task OnGetAsync()
    {
        var idUser = IdUserAtual;

        Recorrentes = await Db.Recorrentes
            .Include(r => r.IdCategoriaNavigation)
            .Where(r => r.IdUser == idUser)
            .OrderBy(r => r.DiaVencimento)
            .ThenBy(r => r.Descricao)
            .ToListAsync();

        // Só os ativos contam pra projeção — um recorrente desativado não
        // deve mais ser somado como compromisso do mês.
        ReceitasRecorrentesMes = Recorrentes.Where(r => r.Ativo && !r.IdCategoriaNavigation.Tipo).Sum(r => r.Valor);
        DespesasRecorrentesMes = Recorrentes.Where(r => r.Ativo && r.IdCategoriaNavigation.Tipo).Sum(r => r.Valor);

        Categorias = await Db.Categorias
            .Where(c => c.IdUser == null || c.IdUser == idUser)
            .OrderBy(c => c.Nome)
            .ToListAsync();
    }

    public Task<IActionResult> OnPostSalvarAsync([FromBody] RecorrenteRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            var descricao = request.Descricao?.Trim() ?? "";
            var idUser = IdUserAtual;

            new Validador()
                .Exigir(!string.IsNullOrWhiteSpace(descricao), "descricao", "Informe a descrição")
                .Exigir(request.Valor is > 0, "valor", "Informe um valor maior que zero")
                .Exigir(request.DiaVencimento is >= 1 and <= 31, "diaVencimento", "Informe um dia entre 1 e 31")
                .Exigir(request.IdCategoria is > 0, "categoria", "Selecione uma categoria")
                .LancarSeInvalido();

            var categoriaValida = await Db.Categorias.AnyAsync(c =>
                c.Id == request.IdCategoria && (c.IdUser == null || c.IdUser == idUser));

            if (!categoriaValida) throw new ErroDeNegocioException("Categoria inválida");

            if (request.Id is int id)
            {
                var recorrente = await Db.Recorrentes.FirstOrDefaultAsync(r => r.Id == id && r.IdUser == idUser);
                if (recorrente is null) throw new ErroDeNegocioException("Recorrente não encontrado");

                recorrente.Descricao = descricao;
                recorrente.Valor = request.Valor!.Value;
                recorrente.DiaVencimento = request.DiaVencimento!.Value;
                recorrente.IdCategoria = request.IdCategoria!.Value;
                recorrente.Ativo = request.Ativo;
            }
            else
            {
                Db.Recorrentes.Add(new Recorrente
                {
                    IdUser = idUser,
                    Descricao = descricao,
                    Valor = request.Valor!.Value,
                    DiaVencimento = request.DiaVencimento!.Value,
                    IdCategoria = request.IdCategoria!.Value,
                    TipoVencimento = 1,
                    Ativo = request.Ativo
                });
            }

            await Db.SaveChangesAsync();
            return new JsonResult(new { sucesso = true }) { StatusCode = 200 };
        });
    }

    public Task<IActionResult> OnPostAlternarAtivoAsync([FromBody] AlternarAtivoRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            var idUser = IdUserAtual;
            var recorrente = await Db.Recorrentes.FirstOrDefaultAsync(r => r.Id == request.Id && r.IdUser == idUser);
            if (recorrente is null) throw new ErroDeNegocioException("Recorrente não encontrado");

            recorrente.Ativo = !recorrente.Ativo;
            await Db.SaveChangesAsync();
            return new JsonResult(new { sucesso = true, ativo = recorrente.Ativo }) { StatusCode = 200 };
        });
    }

    public Task<IActionResult> OnPostExcluirAsync([FromBody] ExcluirRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            var idUser = IdUserAtual;
            var recorrente = await Db.Recorrentes.FirstOrDefaultAsync(r => r.Id == request.Id && r.IdUser == idUser);
            if (recorrente is null) throw new ErroDeNegocioException("Recorrente não encontrado");

            var emUso = await Db.Dividas.AnyAsync(d => d.IdRecorrente == recorrente.Id);
            if (emUso) throw new ErroDeNegocioException("Este recorrente está vinculado a uma dívida e não pode ser excluído");

            Db.Recorrentes.Remove(recorrente);
            await Db.SaveChangesAsync();
            return new JsonResult(new { sucesso = true }) { StatusCode = 200 };
        });
    }
}
@{
    ViewData["Title"] = "Recorrentes";
    var culturaBr = new CultureInfo("pt-BR");
}

<div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
    <div>
        <h1 class="font-display fs-2 fw-bold text-dark mb-0">Recorrentes</h1>
        <p class="text-secondary mt-1 mb-0">Lançamentos que se repetem todo mês</p>
    </div>
    <button type="button" class="btn btn-primary text-nowrap" onclick="abrirModalNovo()">+ Novo recorrente</button>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-secondary small mb-1">Receitas recorrentes/mês</p>
                <p class="fs-4 fw-bold text-success mb-0">@ReceitasRecorrentesMes.ToString("C", culturaBr)</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-secondary small mb-1">Despesas recorrentes/mês</p>
                <p class="fs-4 fw-bold text-danger mb-0">@DespesasRecorrentesMes.ToString("C", culturaBr)</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-body">
                <p class="text-secondary small mb-1">Saldo recorrente/mês</p>
                @{ var saldoRecorrente = ReceitasRecorrentesMes - DespesasRecorrentesMes; }
                <p class="fs-4 fw-bold @(saldoRecorrente >= 0 ? "text-success" : "text-danger") mb-0">
                    @saldoRecorrente.ToString("C", culturaBr)
                </p>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-danger py-2 px-3 small d-none" id="erroGeral"></div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th>Descrição</th>
                    <th>Categoria</th>
                    <th>Dia</th>
                    <th class="text-end">Valor</th>
                    <th>Status</th>
                    <th class="text-end">Ações</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var recorrente in Recorrentes)
                {
                    var despesa = recorrente.IdCategoriaNavigation.Tipo;
                    <tr class="@(recorrente.Ativo ? "" : "text-secondary")">
                        <td>@recorrente.Descricao</td>
                        <td>@recorrente.IdCategoriaNavigation.Nome</td>
                        <td>Todo dia @recorrente.DiaVencimento</td>
                        <td class="text-end @(recorrente.Ativo ? (despesa ? "text-danger" : "text-success") : "") fw-semibold">
                            @((despesa ? "- " : "+ "))@recorrente.Valor.ToString("C", culturaBr)
                        </td>
                        <td>
                            @if (recorrente.Ativo)
                            {
                                <span class="badge text-bg-success">Ativo</span>
                            }
                            else
                            {
                                <span class="badge text-bg-light border">Inativo</span>
                            }
                        </td>
                        <td class="text-end">
                            <button type="button" class="btn btn-sm btn-link text-secondary p-0 me-2 btn-editar-recorrente"
                                    data-id="@recorrente.Id"
                                    data-descricao="@recorrente.Descricao"
                                    data-valor="@recorrente.Valor.ToString(CultureInfo.InvariantCulture)"
                                    data-dia="@recorrente.DiaVencimento"
                                    data-categoria="@recorrente.IdCategoria"
                                    data-ativo="@recorrente.Ativo.ToString().ToLowerInvariant()">Editar</button>
                            <button type="button" class="btn btn-sm btn-link text-secondary p-0 me-2 btn-alternar-recorrente" data-id="@recorrente.Id">
                                @(recorrente.Ativo ? "Desativar" : "Ativar")
                            </button>
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 btn-excluir-recorrente" data-id="@recorrente.Id">Excluir</button>
                        </td>
                    </tr>
                }
                @if (Recorrentes.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center text-secondary py-4">Nenhum recorrente cadastrado</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal de criação/edição -->
<div class="modal fade" id="modalRecorrente" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header">
                <h5 class="modal-title" id="tituloModalRecorrente">Novo recorrente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="recorrenteId" />

                <div class="mb-3">
                    <label for="recorrenteDescricao" class="form-label">Descrição</label>
                    <input type="text" id="recorrenteDescricao" class="form-control" placeholder="Ex.: Aluguel" />
                    <span class="erro-input text-danger small d-none" id="erroDescricao"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label for="recorrenteValor" class="form-label">Valor</label>
                        <input type="number" step="0.01" min="0" id="recorrenteValor" class="form-control" placeholder="0,00" />
                        <span class="erro-input text-danger small d-none" id="erroValor"></span>
                    </div>
                    <div class="col-6">
                        <label for="recorrenteDia" class="form-label">Dia do vencimento</label>
                        <input type="number" step="1" min="1" max="31" id="recorrenteDia" class="form-control" placeholder="Ex.: 10" />
                        <span class="erro-input text-danger small d-none" id="erroDiaVencimento"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label for="recorrenteCategoria" class="form-label">Categoria</label>
                    <select id="recorrenteCategoria" class="form-select">
                        <option value="">Selecione...</option>
                        <optgroup label="Receitas">
                            @foreach (var categoria in Categorias.Where(c => !c.Tipo))
                            {
                                <option value="@categoria.Id">@categoria.Nome</option>
                            }
                        </optgroup>
                        <optgroup label="Despesas">
                            @foreach (var categoria in Categorias.Where(c => c.Tipo))
                            {
                                <option value="@categoria.Id">@categoria.Nome</option>
                            }
                        </optgroup>
                    </select>
                    <span class="erro-input text-danger small d-none" id="erroCategoria"></span>
                </div>

                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="recorrenteAtivo" checked>
                    <label class="form-check-label" for="recorrenteAtivo">Ativo</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnSalvarRecorrente" onclick="salvarRecorrente()">Salvar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalRecorrente = new bootstrap.Modal(document.getElementById('modalRecorrente'));

        function token() {
            return $('input[name="__RequestVerificationToken"]').first().val();
        }

        function abrirModalNovo() {
            limparErros();
            document.getElementById('tituloModalRecorrente').textContent = 'Novo recorrente';
            $('#recorrenteId').val('');
            $('#recorrenteDescricao').val('');
            $('#recorrenteValor').val('');
            $('#recorrenteDia').val('');
            $('#recorrenteCategoria').val('');
            $('#recorrenteAtivo').prop('checked', true);
            modalRecorrente.show();
        }

        function abrirModalEditar(id, descricao, valor, dia, idCategoria, ativo) {
            limparErros();
            document.getElementById('tituloModalRecorrente').textContent = 'Editar recorrente';
            $('#recorrenteId').val(id);
            $('#recorrenteDescricao').val(descricao);
            $('#recorrenteValor').val(valor);
            $('#recorrenteDia').val(dia);
            $('#recorrenteCategoria').val(idCategoria);
            $('#recorrenteAtivo').prop('checked', ativo);
            modalRecorrente.show();
        }

        $(document).on('click', '.btn-editar-recorrente', function () {
            const $btn = $(this);
            abrirModalEditar($btn.data('id'), $btn.data('descricao'), $btn.data('valor'), $btn.data('dia'), $btn.data('categoria'), $btn.data('ativo') === true || $btn.data('ativo') === 'true');
        });

        $(document).on('click', '.btn-excluir-recorrente', function () {
            excluirRecorrente($(this).data('id'));
        });

        $(document).on('click', '.btn-alternar-recorrente', function () {
            alternarAtivo($(this).data('id'));
        });

        function salvarRecorrente() {
            limparErros();

            const id = $('#recorrenteId').val();

            $('#btnSalvarRecorrente').prop('disabled', true);

            $.ajax({
                url: '/App/ControleFinanceiro/Recorrentes?handler=Salvar',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': $('#modalRecorrente input[name="__RequestVerificationToken"]').val() },
                data: JSON.stringify({
                    id: id ? parseInt(id) : null,
                    descricao: $('#recorrenteDescricao').val(),
                    valor: $('#recorrenteValor').val() ? parseFloat($('#recorrenteValor').val()) : null,
                    diaVencimento: $('#recorrenteDia').val() ? parseInt($('#recorrenteDia').val()) : null,
                    idCategoria: $('#recorrenteCategoria').val() ? parseInt($('#recorrenteCategoria').val()) : null,
                    ativo: $('#recorrenteAtivo').is(':checked')
                }),
                success: function () {
                    window.location.reload();
                },
                error: function (xhr) {
                    $('#btnSalvarRecorrente').prop('disabled', false);
                    mostrarErros(xhr);
                }
            });
        }

        function alternarAtivo(id) {
            $.ajax({
                url: '/App/ControleFinanceiro/Recorrentes?handler=AlternarAtivo',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                data: JSON.stringify({ id: id }),
                success: function () {
                    window.location.reload();
                },
                error: function () {
                    alert('Erro ao alterar status do recorrente.');
                }
            });
        }

        function excluirRecorrente(id) {
            if (!confirm('Excluir este recorrente?')) return;

            $.ajax({
                url: '/App/ControleFinanceiro/Recorrentes?handler=Excluir',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                data: JSON.stringify({ id: id }),
                success: function () {
                    window.location.reload();
                },
                error: function (xhr) {
                    if (xhr.status === 400 && xhr.responseJSON && xhr.responseJSON.mensagem) {
                        alert(xhr.responseJSON.mensagem);
                    } else {
                        alert('Erro ao excluir recorrente.');
                    }
                }
            });
        }
    </script>
}
