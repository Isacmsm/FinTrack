@page
@using Microsoft.AspNetCore.DataProtection
@using Microsoft.AspNetCore.Http
@using FinTrack.Data
@using FinTrack.Models
@using Microsoft.EntityFrameworkCore
@using System.Text.Json
@inject FinTrackDbContext Db
@inject IDataProtectionProvider DataProtectionProvider
@inject PluggyApiClient PluggyApi
@inject PluggyLogSessao LogPluggy
@functions {

    private const string PropositoProtecao = "Pluggy.Credenciais";
    private const int IdCategoriaOutrasReceitas = 4;
    private const int IdCategoriaOutrasDespesas = 13;
    private const int IdCategoriaInvestimentoAplicacao = 16;
    private const int IdCategoriaInvestimentoResgate = 17;
    private const int IdCategoriaPagamentoFatura = 18;
    private const int IdCategoriaRecebimentoFatura = 19;

    /// <summary>
    /// "Credit card payment" na taxonomia da Pluggy. Vale mais que o
    /// MapaMovimentacaoInterna abaixo, que casa a descrição em português que a
    /// Nubank usa ("Pagamento recebido") — outro banco escreve outra coisa, o
    /// categoryId é o mesmo pra todos.
    /// </summary>
    private const string PluggyCategoriaIdPagamentoCartao = "05100000";

    /// <summary>
    /// Palavras-chave conhecidas na descrição -> categoria real do FinTrack.
    /// Só se aplica a débitos (gasto de verdade); um crédito (estorno,
    /// reembolso) nunca entra aqui, porque toda categoria mapeada é despesa —
    /// jogar um crédito nela inflaria a despesa em vez de reduzir. Primeira
    /// que bater na descrição vence. Baseado em texto pela mesma razão do
    /// mapa de movimentação interna: ainda sem evidência real da taxonomia
    /// própria da Pluggy (PluggyCategoria).
    /// </summary>
    private static readonly (string Chave, int IdCategoria)[] PalavrasChaveCategoria =
    [
        ("ifood", 5), ("sra cantina", 5), ("grupo madero", 5), ("farofa", 5), ("sorveteria", 5), ("emporio do pao", 5),
        ("uber", 7),
        ("amazon", 11), ("oboticario", 11),
        ("totalpass", 8), ("drogaria", 8),
        ("barbearia", 10), ("ingresso.com", 10),
        ("claude", 12), ("anthropic", 12), ("apple.com", 12), ("discord", 12), ("nucel", 12), ("livepix", 12), ("steam", 12)
    ];

    private static int? CategoriaPorPalavraChave(string descricao)
    {
        foreach (var (chave, idCategoria) in PalavrasChaveCategoria)
        {
            if (descricao.Contains(chave, StringComparison.OrdinalIgnoreCase)) return idCategoria;
        }

        return null;
    }

    /// <summary>
    /// Descrições conhecidas de movimentação interna — dinheiro mudando de
    /// lugar dentro das contas do próprio usuário (aplicação/resgate
    /// automático de investimento, ou pagamento da própria fatura do
    /// cartão), não receita/despesa de verdade. Cada descrição mapeia pro par
    /// (categoria quando é débito, categoria quando é crédito). Regra
    /// baseada em texto porque ainda não observamos se a taxonomia própria da
    /// Pluggy (campo category/categoryId, já capturado em PluggyCategoria)
    /// tem um valor melhor pra detectar isso.
    /// </summary>
    private static readonly Dictionary<string, (int Despesa, int Receita)> MapaMovimentacaoInterna = new(StringComparer.OrdinalIgnoreCase)
    {
        ["Aplicação RDB"] = (IdCategoriaInvestimentoAplicacao, IdCategoriaInvestimentoResgate),
        ["Resgate RDB"] = (IdCategoriaInvestimentoAplicacao, IdCategoriaInvestimentoResgate),
        ["Aplicação em Tesouro Direto"] = (IdCategoriaInvestimentoAplicacao, IdCategoriaInvestimentoResgate),
        ["Valor recebido de Investimentos"] = (IdCategoriaInvestimentoAplicacao, IdCategoriaInvestimentoResgate),
        ["Valor transferido para Investimentos"] = (IdCategoriaInvestimentoAplicacao, IdCategoriaInvestimentoResgate),
        ["Pagamento de fatura"] = (IdCategoriaPagamentoFatura, IdCategoriaRecebimentoFatura),
        ["Pagamento recebido"] = (IdCategoriaPagamentoFatura, IdCategoriaRecebimentoFatura)
    };

    /// <summary>
    /// Dinheiro entrando num cartão de crédito é pagamento de fatura ou
    /// estorno de compra, e as duas coisas não podem ser confundidas: o
    /// pagamento quita fatura, o estorno abate compra. O categoryId da Pluggy
    /// separa os dois sem depender da descrição; a descrição fica só como
    /// segunda opção, pra conector que não categorize.
    /// </summary>
    private static bool EhPagamentoDeFatura(PluggyAccountDto conta, PluggyTransactionDto t)
    {
        if (conta.Type != "CREDIT" || t.Type != "CREDIT") return false;

        return t.CategoryId == PluggyCategoriaIdPagamentoCartao
               || (t.Description is { Length: > 0 } d
                   && MapaMovimentacaoInterna.TryGetValue(d, out var par)
                   && par.Receita == IdCategoriaRecebimentoFatura);
    }

    public bool TemConexao { get; set; }
    public List<PluggyItem> Items { get; set; } = [];

    public class SalvarConexaoRequest
    {
        public string ClientId { get; set; } = "";
        public string ClientSecret { get; set; } = "";
    }

    public class RegistrarItemRequest
    {
        public string ItemId { get; set; } = "";
    }

    public class SincronizarRequest
    {
        public int PluggyItemId { get; set; }
    }

    public class ExcluirItemRequest
    {
        public int PluggyItemId { get; set; }
    }

    private int IdUserAtual => HttpContext.Session.GetInt32("IdUser")!.Value;

    private IDataProtector Protetor => DataProtectionProvider.CreateProtector(PropositoProtecao);

    public async Task OnGetAsync()
    {
        var idUser = IdUserAtual;

        TemConexao = await Db.PluggyConexoes.AnyAsync(c => c.IdUser == idUser);
        Items = await Db.PluggyItems
            .Where(i => i.IdUser == idUser)
            .OrderBy(i => i.NomeConector)
            .ToListAsync();
    }

    public Task<IActionResult> OnPostSalvarConexaoAsync([FromBody] SalvarConexaoRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            var clientId = request.ClientId?.Trim() ?? "";
            var clientSecret = request.ClientSecret?.Trim() ?? "";

            new Validador()
                .Exigir(!string.IsNullOrWhiteSpace(clientId), "clientId", "Informe o Client ID")
                .Exigir(!string.IsNullOrWhiteSpace(clientSecret), "clientSecret", "Informe o Client Secret")
                .LancarSeInvalido();

            // Confere as credenciais na própria Pluggy antes de gravar —
            // se estiverem erradas, isso já lança e vira erro de validação.
            await PluggyApi.ObterApiKeyAsync(clientId, clientSecret);

            var idUser = IdUserAtual;
            var agora = DateTime.UtcNow;

            var conexao = await Db.PluggyConexoes.FirstOrDefaultAsync(c => c.IdUser == idUser);
            if (conexao is null)
            {
                conexao = new PluggyConexao { IdUser = idUser, CriadoEm = agora };
                Db.PluggyConexoes.Add(conexao);
            }

            conexao.ClientIdProtegido = Protetor.Protect(clientId);
            conexao.ClientSecretProtegido = Protetor.Protect(clientSecret);
            conexao.AtualizadoEm = agora;

            await Db.SaveChangesAsync();
            return new JsonResult(new { sucesso = true }) { StatusCode = 200 };
        });
    }

    public Task<IActionResult> OnPostGerarConnectTokenAsync()
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            var idUser = IdUserAtual;

            var conexao = await Db.PluggyConexoes.FirstOrDefaultAsync(c => c.IdUser == idUser);
            if (conexao is null) throw new ErroDeNegocioException("Salve sua conexão Client ID/Secret antes de conectar um banco");

            var clientId = Protetor.Unprotect(conexao.ClientIdProtegido);
            var clientSecret = Protetor.Unprotect(conexao.ClientSecretProtegido);
            var apiKey = await PluggyApi.ObterApiKeyAsync(clientId, clientSecret);

            var connectToken = await PluggyApi.CriarConnectTokenAsync(apiKey);
            return new JsonResult(new { connectToken }) { StatusCode = 200 };
        });
    }

    public Task<IActionResult> OnPostRegistrarItemAsync([FromBody] RegistrarItemRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            var itemId = request.ItemId?.Trim() ?? "";
            var idUser = IdUserAtual;

            new Validador()
                .Exigir(!string.IsNullOrWhiteSpace(itemId), "itemId", "Informe o Item ID")
                .LancarSeInvalido();

            var conexao = await Db.PluggyConexoes.FirstOrDefaultAsync(c => c.IdUser == idUser);
            if (conexao is null) throw new ErroDeNegocioException("Salve sua conexão Client ID/Secret antes de registrar um banco");

            var clientId = Protetor.Unprotect(conexao.ClientIdProtegido);
            var clientSecret = Protetor.Unprotect(conexao.ClientSecretProtegido);
            var apiKey = await PluggyApi.ObterApiKeyAsync(clientId, clientSecret);

            var itemPluggy = await PluggyApi.ObterItemAsync(apiKey, itemId)
                ?? throw new ErroDeNegocioException("Item ID não encontrado na Pluggy");

            if (await Db.PluggyItems.AnyAsync(i => i.ItemId == itemId))
            {
                throw new ErroDeNegocioException("Este Item já está registrado");
            }

            var contas = await PluggyApi.ListarContasAsync(apiKey, itemId);
            var nomeConector = NomeParaExibicao(contas, itemPluggy);

            Db.PluggyItems.Add(new PluggyItem
            {
                IdUser = idUser,
                ItemId = itemId,
                NomeConector = nomeConector,
                Status = itemPluggy.Status,
                IconeUrl = await IconeParaExibicaoAsync(apiKey, nomeConector, itemPluggy.Connector?.ImageUrl)
            });

            await Db.SaveChangesAsync();
            return new JsonResult(new { sucesso = true }) { StatusCode = 200 };
        });
    }

    /// <summary>
    /// Todo Item do Meu Pluggy usa o mesmo conector "MeuPluggy", então o nome
    /// do conector não distingue um banco do outro — usamos o nome da conta
    /// bancária (tipo BANK), que é a instituição de verdade (ex.: "Nu
    /// Pagamentos S.A. - Instituição de Pagamento"). Cartões (tipo CREDIT)
    /// não entram: o nome deles é só o produto (ex.: "gold"), e listar cada
    /// cartão vira uma lista enorme se o banco tiver vários.
    /// </summary>
    private static string? NomeParaExibicao(List<PluggyAccountDto> contas, PluggyItemDto? item)
    {
        var conta = contas.FirstOrDefault(c => c.Type == "BANK") ?? contas.FirstOrDefault();
        return conta?.Name ?? item?.Connector?.Name;
    }

    /// <summary>
    /// Razão social (como aparece no nome da conta) -> nome fantasia (como
    /// está cadastrado no diretório de connectors reais da Pluggy). Só os
    /// bancos mais comuns; ainda sem evidência real de como a razão social
    /// vem pra cada instituição — completar conforme for aparecendo em
    /// produção. Sem match aqui, fica no ícone genérico do MeuPluggy mesmo.
    /// </summary>
    private static readonly Dictionary<string, string> ApelidoPorRazaoSocial = new(StringComparer.OrdinalIgnoreCase)
    {
        ["nu pagamentos"] = "Nubank",
        ["itau unibanco"] = "Itaú",
        ["banco inter"] = "Inter",
        ["banco bradesco"] = "Bradesco",
        ["banco santander"] = "Santander",
        ["banco do brasil"] = "Banco do Brasil",
        ["caixa economica federal"] = "Caixa Econômica Federal"
    };

    private static string? TermoBuscaConectorReal(string? nomeInstituicao)
    {
        if (string.IsNullOrWhiteSpace(nomeInstituicao)) return null;

        foreach (var (chave, apelido) in ApelidoPorRazaoSocial)
        {
            if (nomeInstituicao.Contains(chave, StringComparison.OrdinalIgnoreCase)) return apelido;
        }

        return null;
    }

    /// <summary>
    /// Tenta achar o ícone do banco de verdade a partir da razão social;
    /// sem match na tabela de apelidos, ou sem resultado na Pluggy, cai pro
    /// ícone genérico do connector "MeuPluggy" que o Item já trouxe.
    /// </summary>
    private async Task<string?> IconeParaExibicaoAsync(string apiKey, string? nomeInstituicao, string? iconeGenerico)
    {
        var termoBusca = TermoBuscaConectorReal(nomeInstituicao);
        if (termoBusca is null) return iconeGenerico;

        var conectorReal = await PluggyApi.BuscarConectorPorNomeAsync(apiKey, termoBusca);
        return conectorReal?.ImageUrl ?? iconeGenerico;
    }

    public Task<IActionResult> OnPostBuscarAsync([FromBody] SincronizarRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, () => ImportarTransacoesAsync(request.PluggyItemId, solicitarAtualizacao: false));
    }

    public Task<IActionResult> OnPostAtualizarAsync([FromBody] SincronizarRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, () => ImportarTransacoesAsync(request.PluggyItemId, solicitarAtualizacao: true));
    }

    /// <summary>
    /// Exclui o Item na Pluggy e o registro local. As transações já
    /// importadas ficam — elas não têm FK pra PluggyItem, viram transações
    /// normais do usuário, como se tivessem sido lançadas à mão.
    /// </summary>
    public Task<IActionResult> OnPostExcluirItemAsync([FromBody] ExcluirItemRequest request)
    {
        return Util.ExecutarHandlerAsync(HttpContext, async () =>
        {
            var idUser = IdUserAtual;

            var conexao = await Db.PluggyConexoes.FirstOrDefaultAsync(c => c.IdUser == idUser);
            if (conexao is null) throw new ErroDeNegocioException("Conecte sua conta do Meu Pluggy antes de excluir uma conexão");

            var item = await Db.PluggyItems.FirstOrDefaultAsync(i => i.Id == request.PluggyItemId && i.IdUser == idUser);
            if (item is null) throw new ErroDeNegocioException("Conexão bancária não encontrada");

            var clientId = Protetor.Unprotect(conexao.ClientIdProtegido);
            var clientSecret = Protetor.Unprotect(conexao.ClientSecretProtegido);
            var apiKey = await PluggyApi.ObterApiKeyAsync(clientId, clientSecret);

            await PluggyApi.ExcluirItemAsync(apiKey, item.ItemId);

            Db.PluggyItems.Remove(item);
            await Db.SaveChangesAsync();

            return new JsonResult(new { sucesso = true }) { StatusCode = 200 };
        });
    }

    /// <summary>
    /// Núcleo comum dos dois botões. "Buscar" só lê o que a Pluggy já tem;
    /// "Atualizar" primeiro pede um PATCH /items — mas pro conector Meu
    /// Pluggy isso é best-effort e pode não ter efeito real (a atualização de
    /// verdade desse conector é diária/automática pela Pluggy, ou manual pelo
    /// portal meu.pluggy.ai). Um 409 aí não é erro, só significa que já foi
    /// atualizado recentemente, então seguimos pra ler mesmo assim.
    /// A janela de busca é sempre fixa (90 dias), não um ponteiro que avança a
    /// cada sincronização — evita perder silenciosamente uma transação que a
    /// Pluggy ainda não tinha capturado da última vez.
    /// </summary>
    /// <summary>
    /// Grava os pagamentos de fatura da conta, deduplicados por (data, valor)
    /// — a chave natural, já que a Pluggy não dá id estável pra pagamento.
    /// Append-only: pagamento não some depois de acontecer, e nada aqui
    /// sobrescreve o que já foi gravado.
    /// </summary>
    private async Task SalvarPagamentosDeFaturaAsync(
        int idUser,
        string contaPluggyId,
        List<(DateTime Data, decimal Valor, string Origem)> pagamentos,
        PluggyLogSessao logPluggy)
    {
        if (pagamentos.Count == 0) return;

        var jaGravados = await Db.PluggyFaturaPagamentos
            .Where(p => p.IdUser == idUser && p.ContaPluggyId == contaPluggyId)
            .Select(p => new { p.Data, p.Valor })
            .ToListAsync();

        var chaves = jaGravados.Select(p => (p.Data, p.Valor)).ToHashSet();
        var novos = new List<PluggyFaturaPagamento>();

        foreach (var pagamento in pagamentos.OrderBy(p => p.Data).ThenBy(p => p.Valor))
        {
            if (pagamento.Valor <= 0) continue;
            if (!chaves.Add((pagamento.Data, pagamento.Valor))) continue;

            novos.Add(new PluggyFaturaPagamento
            {
                IdUser = idUser,
                ContaPluggyId = contaPluggyId,
                Data = pagamento.Data,
                Valor = pagamento.Valor,
                Origem = pagamento.Origem
            });
        }

        if (novos.Count == 0) return;

        Db.PluggyFaturaPagamentos.AddRange(novos);

        logPluggy.Registrar("SALVO", $"{novos.Count} pagamento(s) de fatura", contaPluggyId,
            JsonSerializer.Serialize(novos.Select(p => new { p.Data, p.Valor, p.Origem })),
            "Deduplicados por (data, valor) contra o que já estava gravado. De bills[].payments[] o id, o " +
            "valueType e o paymentMode são descartados (ver BRUTO GET /bills): o id não é estável entre " +
            "faturas e os outros dois não mudam nenhuma conta.");
    }

    private async Task<IActionResult> ImportarTransacoesAsync(int pluggyItemId, bool solicitarAtualizacao)
    {
        var idUser = IdUserAtual;
        // Abre (e trunca) o arquivo deste usuário: cada sincronização
        // substitui a anterior — ver Data/PluggyLogSessao.cs.
        LogPluggy.Iniciar(idUser, HttpContext.Session.GetString("NomeUser") ?? $"usuário {idUser}");

        var conexao = await Db.PluggyConexoes.FirstOrDefaultAsync(c => c.IdUser == idUser);
        if (conexao is null) throw new ErroDeNegocioException("Conecte sua conta do Meu Pluggy antes de sincronizar");

        var item = await Db.PluggyItems.FirstOrDefaultAsync(i => i.Id == pluggyItemId && i.IdUser == idUser);
        if (item is null) throw new ErroDeNegocioException("Conexão bancária não encontrada");

        var clientId = Protetor.Unprotect(conexao.ClientIdProtegido);
        var clientSecret = Protetor.Unprotect(conexao.ClientSecretProtegido);
        var apiKey = await PluggyApi.ObterApiKeyAsync(clientId, clientSecret);

        var atualizacaoSolicitada = solicitarAtualizacao && await PluggyApi.SolicitarAtualizacaoAsync(apiKey, item.ItemId);

        var itemAtualizado = await PluggyApi.ObterItemAsync(apiKey, item.ItemId);
        item.Status = itemAtualizado?.Status;

        var contas = await PluggyApi.ListarContasAsync(apiKey, item.ItemId);
        item.NomeConector = NomeParaExibicao(contas, itemAtualizado);
        item.IconeUrl = await IconeParaExibicaoAsync(apiKey, item.NomeConector, itemAtualizado?.Connector?.ImageUrl);

        LogPluggy.Registrar("SALVO", "Item", item.ItemId,
            JsonSerializer.Serialize(new { item.Status, item.NomeConector, item.IconeUrl }),
            "O resto do Item (executionStatus, connector completo) e das contas (saldo, subtype, currencyCode, " +
            "número — ver BRUTO GET /accounts pra essa lista) não é persistido em lugar nenhum; só Id/Name/Type " +
            "de cada conta viram ContaPluggyId/ContaNome/ContaTipo dentro de cada Transacao/PluggyFatura.");

        var dataDe = DateTime.Today.AddDays(-90);
        var novasTransacoes = 0;

        // Herda a categoria do comércio a partir da transação mais recente já
        // categorizada pro mesmo comércio (ex.: usuário mudou "iFood" pra
        // "Delivery" em Transações — as próximas importações seguem isso, sem
        // depender só da lista fixa de palavras-chave).
        var categoriaPorChaveComercio = new Dictionary<string, int>();
        var transacoesExistentesUsuario = await Db.Transacoes
            .Where(x => x.IdUser == idUser)
            .OrderByDescending(x => x.Data)
            .Select(x => new { x.MerchantNome, x.Desc, x.IdCategoria })
            .ToListAsync();
        foreach (var tx in transacoesExistentesUsuario)
        {
            var chave = ComercioHelper.ChaveComercio(tx.MerchantNome, tx.Desc);
            if (!string.IsNullOrWhiteSpace(chave))
                categoriaPorChaveComercio.TryAdd(chave, tx.IdCategoria);
        }

        foreach (var conta in contas)
        {
            // Pagamentos de fatura, juntando as duas fontes que a Pluggy tem
            // (bills[].payments[] e as transações do extrato do cartão) e
            // deduplicando pela chave natural — nenhuma das duas é confiável
            // sozinha: a Pluggy repete o mesmo pagamento com ids diferentes
            // entre faturas, e repete de novo no extrato. Ver
            // Models/PluggyFaturaPagamento.cs.
            var pagamentosDaConta = new List<(DateTime Data, decimal Valor, string Origem)>();

            if (conta.Type == "CREDIT")
            {
                var faturasPluggy = await PluggyApi.ListarFaturasAsync(apiKey, conta.Id);
                var idsFaturasPluggy = faturasPluggy.Select(f => f.Id).ToList();
                var faturasExistentesPorId = await Db.PluggyFaturas
                    .Where(f => idsFaturasPluggy.Contains(f.BillId))
                    .ToDictionaryAsync(f => f.BillId);

                foreach (var faturaPluggy in faturasPluggy)
                {
                    // Sem vínculo com esta fatura de propósito: payments[] de
                    // uma fatura lista todo pagamento que caiu na janela dela,
                    // inclusive o que quitou a anterior e o que adiantou a
                    // seguinte (por isso a soma abaixo passa do total da
                    // fatura em 4 das 6 faturas reais que testei). Quem casa
                    // pagamento com fatura é a FaturaCalculadora, pelas datas.
                    foreach (var p in faturaPluggy.Payments ?? [])
                        pagamentosDaConta.Add((p.PaymentDate.Date, Math.Abs(p.Amount), "bill"));

                    var valorPago = faturaPluggy.Payments?.Sum(p => p.Amount) ?? 0;
                    var dataUltimoPagamento = faturaPluggy.Payments?.Count > 0
                        ? faturaPluggy.Payments.Max(p => p.PaymentDate)
                        : (DateTime?)null;

                    PluggyFatura faturaSalva;
                    if (faturasExistentesPorId.TryGetValue(faturaPluggy.Id, out var faturaExistente))
                    {
                        faturaExistente.ContaNome = conta.Name;
                        faturaExistente.DataVencimento = faturaPluggy.DueDate;
                        faturaExistente.DataFechamento = faturaPluggy.BillClosingDate;
                        faturaExistente.ValorTotal = faturaPluggy.TotalAmount;
                        faturaExistente.ValorMinimo = faturaPluggy.MinimumPaymentAmount;
                        faturaExistente.ValorPago = valorPago;
                        faturaExistente.DataUltimoPagamento = dataUltimoPagamento;
                        faturaSalva = faturaExistente;
                    }
                    else
                    {
                        faturaSalva = new PluggyFatura
                        {
                            IdUser = idUser,
                            BillId = faturaPluggy.Id,
                            ContaPluggyId = conta.Id,
                            ContaNome = conta.Name,
                            DataVencimento = faturaPluggy.DueDate,
                            DataFechamento = faturaPluggy.BillClosingDate,
                            ValorTotal = faturaPluggy.TotalAmount,
                            ValorMinimo = faturaPluggy.MinimumPaymentAmount,
                            ValorPago = valorPago,
                            DataUltimoPagamento = dataUltimoPagamento
                        };
                        Db.PluggyFaturas.Add(faturaSalva);
                    }

                    // Projeção, não a entidade: faturaExistente vem de uma query rastreada pelo EF, e o
                    // change tracker faz fixup de navegação (IdUserNavigation etc.) sozinho sempre que
                    // outro Usuario/Categoria já foi materializado neste mesmo DbContext — serializar a
                    // entidade direto arrisca ciclo (JsonException) e derrubaria o Buscar inteiro.
                    LogPluggy.Registrar("SALVO", "fatura", faturaPluggy.Id,
                        JsonSerializer.Serialize(new
                        {
                            faturaSalva.BillId,
                            faturaSalva.ContaPluggyId,
                            faturaSalva.ContaNome,
                            faturaSalva.DataVencimento,
                            faturaSalva.DataFechamento,
                            faturaSalva.ValorTotal,
                            faturaSalva.ValorMinimo,
                            faturaSalva.ValorPago,
                            faturaSalva.DataUltimoPagamento
                        }),
                        "allowsInstallments (do BRUTO GET /bills) não tem coluna e não é salvo. ValorPago é a soma crua " +
                        "de payments[] e NÃO é status de pagamento — quem casa pagamento com fatura é a FaturaCalculadora, " +
                        "a partir de PluggyFaturaPagamento.");
                }
            }

            var transacoesPluggy = await PluggyApi.ListarTransacoesAsync(apiKey, conta.Id, dataDe);

            // Uma consulta por conta, não uma por transação: pega de uma vez
            // as que já existem localmente pra decidir update vs insert.
            var idsPluggy = transacoesPluggy.Select(t => t.Id).ToList();
            var existentesPorId = await Db.Transacoes
                .Where(x => x.PluggyTransactionId != null && idsPluggy.Contains(x.PluggyTransactionId))
                .ToDictionaryAsync(x => x.PluggyTransactionId!);

            foreach (var t in transacoesPluggy)
            {
                // Antes do desvio entre update e insert: o pagamento tem que
                // ser coletado mesmo quando a transação já existe localmente,
                // senão só a primeira importação enxergaria os pagamentos.
                if (EhPagamentoDeFatura(conta, t))
                    pagamentosDaConta.Add((t.Date.Date, Math.Abs(t.AmountInAccountCurrency ?? t.Amount), "extrato"));

                if (existentesPorId.TryGetValue(t.Id, out var existente))
                {
                    // Já importada — só atualiza os campos vindos da Pluggy
                    // (merchant/conta podem ter sido adicionados depois que
                    // essa linha foi criada), sem mexer em categoria ou valor,
                    // que já podem ter sido ajustados manualmente pelo usuário.
                    existente.MerchantNome = t.Merchant?.Name;
                    existente.MerchantCnpj = t.Merchant?.Cnpj;
                    existente.ContaPluggyId = conta.Id;
                    existente.ContaNome = conta.Name;
                    existente.ContaTipo = conta.Type;
                    existente.PluggyBillId = t.CreditCardMetadata?.BillId;
                    existente.PluggyFaturaPrevista = t.CreditCardMetadata?.BillForecastDate;
                    existente.PluggyParcelaAtual = t.CreditCardMetadata?.InstallmentNumber;
                    existente.PluggyParcelaTotal = t.CreditCardMetadata?.TotalInstallments;
                    existente.PluggyValorCompraTotal = t.CreditCardMetadata?.TotalAmount;
                    existente.PluggyDataCompra = t.CreditCardMetadata?.PurchaseDate;
                    existente.MoedaOriginalCodigo = t.AmountInAccountCurrency.HasValue ? t.CurrencyCode : null;
                    existente.ValorMoedaOriginal = t.AmountInAccountCurrency.HasValue ? Math.Abs(t.Amount) : null;

                    // Único caso em que o Valor de uma transação já importada é
                    // reescrito. Compra internacional tem dois valores: Amount
                    // na moeda original (ex.: 21.57 USD) e AmountInAccountCurrency
                    // no que saiu do cartão (114.95 BRL). Importações antigas
                    // gravaram o primeiro, e como reimportação não mexe em Valor
                    // (o usuário pode ter ajustado à mão), a linha ficaria errada
                    // pra sempre — e some das faturas quase 100% do valor dela.
                    // Só reescreve quando o Valor gravado é exatamente o número
                    // na moeda estrangeira, que é assinatura do bug e não algo
                    // que alguém digitaria por acaso.
                    if (t.AmountInAccountCurrency is decimal valorNaConta
                        && existente.Valor == Math.Abs(t.Amount)
                        && existente.Valor != Math.Abs(valorNaConta))
                    {
                        existente.Valor = Math.Abs(valorNaConta);
                    }

                    // Projeção dos campos tocados, não a entidade "existente" — ela vem de uma query
                    // rastreada (Db.Transacoes acima), e o EF pode ter feito fixup de navegação com
                    // Categoria/Usuario já materializados neste DbContext; serializar a entidade arrisca
                    // ciclo (Transacao → Categoria → Transacoes[] → Transacao) e derrubaria o Buscar.
                    LogPluggy.Registrar("SALVO", "transação (já existia)", t.Id,
                        JsonSerializer.Serialize(new
                        {
                            existente.MerchantNome,
                            existente.MerchantCnpj,
                            existente.ContaPluggyId,
                            existente.ContaNome,
                            existente.ContaTipo,
                            existente.PluggyBillId,
                            existente.PluggyFaturaPrevista,
                            existente.PluggyParcelaAtual,
                            existente.PluggyParcelaTotal,
                            existente.PluggyValorCompraTotal,
                            existente.PluggyDataCompra,
                            existente.MoedaOriginalCodigo,
                            existente.ValorMoedaOriginal
                        }),
                        "Valor/Data/IdCategoria/Desc ficaram como o usuário deixou; só os campos vindos da Pluggy foram " +
                        "atualizados. Única exceção: compra internacional gravada com o valor em moeda estrangeira é " +
                        "corrigida pro valor em BRL.");
                    continue;
                }

                var receita = t.Type == "CREDIT";
                var descricao = t.Description ?? "";

                int idCategoria;
                if (EhPagamentoDeFatura(conta, t))
                    idCategoria = IdCategoriaRecebimentoFatura;
                else if (!string.IsNullOrWhiteSpace(descricao) && MapaMovimentacaoInterna.TryGetValue(descricao, out var par))
                    idCategoria = receita ? par.Receita : par.Despesa;
                else if (categoriaPorChaveComercio.TryGetValue(ComercioHelper.ChaveComercio(t.Merchant?.Name, descricao), out var idPorComercio))
                    idCategoria = idPorComercio;
                else if (!receita && CategoriaPorPalavraChave(descricao) is int idPorPalavraChave)
                    idCategoria = idPorPalavraChave;
                else
                    idCategoria = receita ? IdCategoriaOutrasReceitas : IdCategoriaOutrasDespesas;

                var novaTransacao = new Transacao
                {
                    IdUser = idUser,
                    Desc = string.IsNullOrWhiteSpace(t.Description) ? conta.Name : t.Description,
                    // Compra internacional: Amount vem na moeda original (ex.:
                    // USD), AmountInAccountCurrency é o que realmente saiu da
                    // conta em BRL.
                    Valor = Math.Abs(t.AmountInAccountCurrency ?? t.Amount),
                    Data = t.Date,
                    IdCategoria = idCategoria,
                    PluggyTransactionId = t.Id,
                    PluggyCategoria = t.Category,
                    PluggyCategoriaId = t.CategoryId,
                    MerchantNome = t.Merchant?.Name,
                    MerchantCnpj = t.Merchant?.Cnpj,
                    ContaPluggyId = conta.Id,
                    ContaNome = conta.Name,
                    ContaTipo = conta.Type,
                    PluggyBillId = t.CreditCardMetadata?.BillId,
                    PluggyFaturaPrevista = t.CreditCardMetadata?.BillForecastDate,
                    PluggyParcelaAtual = t.CreditCardMetadata?.InstallmentNumber,
                    PluggyParcelaTotal = t.CreditCardMetadata?.TotalInstallments,
                    PluggyValorCompraTotal = t.CreditCardMetadata?.TotalAmount,
                    PluggyDataCompra = t.CreditCardMetadata?.PurchaseDate,
                    MoedaOriginalCodigo = t.AmountInAccountCurrency.HasValue ? t.CurrencyCode : null,
                    ValorMoedaOriginal = t.AmountInAccountCurrency.HasValue ? Math.Abs(t.Amount) : null
                };
                Db.Transacoes.Add(novaTransacao);
                novasTransacoes++;

                // Projeção, não a entidade — mesmo motivo do bloco de update acima: depois do Add,
                // o change tracker do EF pode ligar IdCategoriaNavigation/IdUserNavigation a qualquer
                // Categoria/Usuario já materializado neste DbContext, arriscando ciclo na serialização.
                LogPluggy.Registrar("SALVO", "transação (nova)", t.Id,
                    JsonSerializer.Serialize(new
                    {
                        novaTransacao.Desc,
                        novaTransacao.Valor,
                        novaTransacao.Data,
                        novaTransacao.IdCategoria,
                        novaTransacao.PluggyTransactionId,
                        novaTransacao.PluggyCategoria,
                        novaTransacao.PluggyCategoriaId,
                        novaTransacao.MerchantNome,
                        novaTransacao.MerchantCnpj,
                        novaTransacao.ContaPluggyId,
                        novaTransacao.ContaNome,
                        novaTransacao.ContaTipo,
                        novaTransacao.PluggyBillId,
                        novaTransacao.PluggyFaturaPrevista,
                        novaTransacao.PluggyParcelaAtual,
                        novaTransacao.PluggyParcelaTotal,
                        novaTransacao.PluggyValorCompraTotal,
                        novaTransacao.PluggyDataCompra,
                        novaTransacao.MoedaOriginalCodigo,
                        novaTransacao.ValorMoedaOriginal
                    }),
                    "Tudo que a Pluggy trouxe pra esta transação e não aparece aqui foi descartado — ver o BRUTO " +
                    "GET /v2/transactions com o mesmo id.");
            }

            await SalvarPagamentosDeFaturaAsync(idUser, conta.Id, pagamentosDaConta, LogPluggy);
        }

        var investimentosPluggy = await PluggyApi.ListarInvestimentosAsync(apiKey, item.ItemId);
        var idsInvestimentosPluggy = investimentosPluggy.Select(i => i.Id).ToList();
        var investimentosExistentesPorId = await Db.PluggyInvestimentos
            .Where(i => idsInvestimentosPluggy.Contains(i.InvestmentId))
            .ToDictionaryAsync(i => i.InvestmentId);

        foreach (var inv in investimentosPluggy)
        {
            PluggyInvestimento investimentoSalvo;
            if (investimentosExistentesPorId.TryGetValue(inv.Id, out var invExistente))
            {
                invExistente.NomeConector = item.NomeConector;
                invExistente.Tipo = inv.Type;
                invExistente.Subtipo = inv.Subtype;
                invExistente.Nome = inv.Name;
                invExistente.Codigo = inv.Code;
                invExistente.Isin = inv.Isin;
                invExistente.Saldo = inv.Balance;
                invExistente.ValorOriginal = inv.AmountOriginal;
                invExistente.LucroInformado = inv.AmountProfit;
                invExistente.ValorDisponivelResgate = inv.AmountWithdrawal;
                invExistente.Quantidade = inv.Quantity;
                invExistente.ValorCota = inv.Value;
                invExistente.MoedaCodigo = inv.CurrencyCode;
                invExistente.Data = inv.Date;
                invExistente.DataVencimento = inv.DueDate;
                invExistente.DataAplicacao = inv.PurchaseDate;
                invExistente.Taxa = inv.Rate;
                invExistente.TipoTaxa = inv.RateType;
                invExistente.TaxaAnualFixa = inv.FixedAnnualRate;
                invExistente.Emissor = inv.Issuer;
                invExistente.Status = inv.Status;
                investimentoSalvo = invExistente;
            }
            else
            {
                investimentoSalvo = new PluggyInvestimento
                {
                    IdUser = idUser,
                    InvestmentId = inv.Id,
                    NomeConector = item.NomeConector,
                    Tipo = inv.Type,
                    Subtipo = inv.Subtype,
                    Nome = inv.Name,
                    Codigo = inv.Code,
                    Isin = inv.Isin,
                    Saldo = inv.Balance,
                    ValorOriginal = inv.AmountOriginal,
                    LucroInformado = inv.AmountProfit,
                    ValorDisponivelResgate = inv.AmountWithdrawal,
                    Quantidade = inv.Quantity,
                    ValorCota = inv.Value,
                    MoedaCodigo = inv.CurrencyCode,
                    Data = inv.Date,
                    DataVencimento = inv.DueDate,
                    DataAplicacao = inv.PurchaseDate,
                    Taxa = inv.Rate,
                    TipoTaxa = inv.RateType,
                    TaxaAnualFixa = inv.FixedAnnualRate,
                    Emissor = inv.Issuer,
                    Status = inv.Status
                };
                Db.PluggyInvestimentos.Add(investimentoSalvo);
            }

            // Projeção, não a entidade — mesmo motivo dos blocos acima: invExistente vem de uma
            // query rastreada (Db.PluggyInvestimentos acima), sujeita a fixup de navegação do EF.
            LogPluggy.Registrar("SALVO", "investimento", inv.Id,
                JsonSerializer.Serialize(new
                {
                    investimentoSalvo.InvestmentId,
                    investimentoSalvo.NomeConector,
                    investimentoSalvo.Tipo,
                    investimentoSalvo.Subtipo,
                    investimentoSalvo.Nome,
                    investimentoSalvo.Codigo,
                    investimentoSalvo.Isin,
                    investimentoSalvo.Saldo,
                    investimentoSalvo.ValorOriginal,
                    investimentoSalvo.LucroInformado,
                    investimentoSalvo.ValorDisponivelResgate,
                    investimentoSalvo.Quantidade,
                    investimentoSalvo.ValorCota,
                    investimentoSalvo.MoedaCodigo,
                    investimentoSalvo.Data,
                    investimentoSalvo.DataVencimento,
                    investimentoSalvo.DataAplicacao,
                    investimentoSalvo.Taxa,
                    investimentoSalvo.TipoTaxa,
                    investimentoSalvo.TaxaAnualFixa,
                    investimentoSalvo.Emissor,
                    investimentoSalvo.Status
                }),
                "Comparar com o BRUTO GET /investments de mesmo id pra ver o que a Pluggy trouxe e não é persistido.");
        }

        item.UltimaSincronizacao = DateTime.UtcNow;
        await Db.SaveChangesAsync();

        // Fecha o arquivo do usuário. Se a importação estourar antes daqui, o
        // Dispose do serviço scoped fecha na saída da requisição e o que já foi
        // escrito continua legível no painel — que é justamente quando alguém
        // vai querer ler.
        LogPluggy.Registrar("FIM", "sincronização", item.ItemId,
            JsonSerializer.Serialize(new { novasTransacoes, investimentosSincronizados = investimentosPluggy.Count }),
            "Fim da sincronização.");
        LogPluggy.Finalizar();

        return new JsonResult(new { sucesso = true, novasTransacoes, atualizacaoSolicitada, investimentosSincronizados = investimentosPluggy.Count }) { StatusCode = 200 };
    }
}
@{
    ViewData["Title"] = "Meu Pluggy";
}

<h1 class="font-display fs-2 fw-bold text-dark mb-0">Meu Pluggy</h1>
<p class="text-secondary mt-1">Importe automaticamente as transações do seu banco</p>

<div class="alert alert-danger py-2 px-3 small d-none mt-3" id="erroGeral"></div>

<div class="row g-4 mt-1">
    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">Como conectar</div>
            <div class="card-body small">
                <ol class="mb-0 ps-3">
                    <li class="mb-2">
                        Acesse <a href="https://dashboard.pluggy.ai" target="_blank" rel="noopener">dashboard.pluggy.ai</a>,
                        crie uma equipe e uma aplicação — isso gera seu <strong>Client ID</strong> e
                        <strong>Client Secret</strong> pessoais.
                    </li>
                    <li class="mb-2">Cole essas duas credenciais no formulário ao lado e salve.</li>
                    <li class="mb-0">
                        Clique em <strong>Conectar novo banco</strong> e faça login na sua instituição pela
                        janela que abre — o banco é registrado automaticamente ao terminar.
                    </li>
                </ol>
                <p class="text-secondary small mt-3 mb-0">
                    Já tem uma conta em <a href="https://meu.pluggy.ai/pt" target="_blank" rel="noopener">meu.pluggy.ai</a>
                    com bancos conectados por lá? Use "Registrar Item ID manualmente" com o Item ID de cada um.
                </p>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-semibold">
                Credenciais @(TemConexao ? "conectadas" : "")
            </div>
            <div class="card-body">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label for="clientId" class="form-label">Client ID</label>
                    <input type="text" id="clientId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                    <span class="erro-input text-danger small d-none" id="erroClientId"></span>
                </div>
                <div class="mb-3">
                    <label for="clientSecret" class="form-label">Client Secret</label>
                    <input type="password" id="clientSecret" class="form-control" placeholder="••••••••••••" />
                    <span class="erro-input text-danger small d-none" id="erroClientSecret"></span>
                </div>
                <button type="button" class="btn btn-primary" id="btnSalvarConexao" onclick="salvarConexao()">
                    @(TemConexao ? "Atualizar credenciais" : "Salvar credenciais")
                </button>
                @if (TemConexao)
                {
                    <p class="text-secondary small mt-2 mb-0">
                        Já existe uma credencial salva — só edite se quiser trocar por outra.
                    </p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm mt-4">
    <div class="card-header bg-white d-flex align-items-center justify-content-between">
        <span class="fw-semibold">Bancos conectados</span>
        <span class="d-flex gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary" onclick="abrirModalItem()">Registrar Item ID manualmente</button>
            <button type="button" class="btn btn-sm btn-primary" id="btnConectarBanco" onclick="conectarNovoBanco()">+ Conectar novo banco</button>
        </span>
    </div>
    <ul class="list-group list-group-flush" id="listaItems">
        @foreach (var item in Items)
        {
            <li class="list-group-item d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    @if (!string.IsNullOrWhiteSpace(item.IconeUrl))
                    {
                        <img src="@item.IconeUrl" alt="" width="32" height="32" class="rounded flex-shrink-0" />
                    }
                    <div>
                        <div class="fw-medium">@(item.NomeConector ?? "Banco conectado")</div>
                        <div class="text-secondary small">
                            Status: @(item.Status ?? "—") ·
                            @* Gravado em UTC (DateTime.UtcNow logo acima), exibido no fuso local — ver Data/Fuso.cs. *@
                            Última sincronização: @(Fuso.ParaLocal(item.UltimaSincronizacao)?.ToString("dd/MM/yyyy HH:mm") ?? "nunca")
                        </div>
                    </div>
                </div>
                <span class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary btn-buscar" data-id="@item.Id" title="Lê o que a Pluggy já tem, sem pedir atualização ao banco">
                        Buscar
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary btn-atualizar" data-id="@item.Id" title="Pede à Pluggy pra buscar dados novos — best-effort, pode não ter efeito no Meu Pluggy. A atualização de verdade é diária/automática, ou manual em meu.pluggy.ai">
                        Atualizar
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger btn-excluir" data-id="@item.Id" data-nome="@(item.NomeConector ?? "este banco")" title="Remove a conexão da Pluggy e daqui. As transações já importadas continuam no seu extrato.">
                        Excluir
                    </button>
                </span>
            </li>
        }
        @if (Items.Count == 0)
        {
            <li class="list-group-item text-secondary small">Nenhum banco registrado ainda</li>
        }
    </ul>
</div>

<!-- Modal registrar Item ID -->
<div class="modal fade" id="modalItem" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Registrar Item ID</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <label for="itemId" class="form-label">Item ID</label>
                <input type="text" id="itemId" class="form-control" placeholder="00000000-0000-0000-0000-000000000000" />
                <span class="erro-input text-danger small d-none" id="erroItemId"></span>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnRegistrarItem" onclick="registrarItem()">Registrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.pluggy.ai/pluggy-connect/v2.8.2/pluggy-connect.js"></script>
    <script>
        const modalItem = new bootstrap.Modal(document.getElementById('modalItem'));

        function token() {
            return $('input[name="__RequestVerificationToken"]').first().val();
        }

        /// Abre o widget oficial da Pluggy pro usuário logar direto no banco.
        /// O item nasce no nosso app (não precisa de meu.pluggy.ai) e o
        /// onSuccess já devolve o itemId pronto pra registrar.
        function conectarNovoBanco() {
            limparErros();
            var $btn = $('#btnConectarBanco');
            $btn.prop('disabled', true);

            $.ajax({
                url: '/App/Configuracoes/Pluggy?handler=GerarConnectToken',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                success: function (response) {
                    $btn.prop('disabled', false);

                    const connect = new PluggyConnect({
                        connectToken: response.connectToken,
                        includeSandbox: true,
                        onSuccess: function (data) {
                            registrarItemDoWidget(data.item.id);
                        },
                        onError: function (error) {
                            alert('Erro ao conectar: ' + (error.message || 'tente novamente'));
                        }
                    });
                    connect.init();
                },
                error: function (xhr) {
                    $btn.prop('disabled', false);
                    mostrarErros(xhr);
                }
            });
        }

        function registrarItemDoWidget(itemId) {
            $.ajax({
                url: '/App/Configuracoes/Pluggy?handler=RegistrarItem',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                data: JSON.stringify({ itemId: itemId }),
                success: function () {
                    window.location.reload();
                },
                error: function (xhr) {
                    alert('Banco conectado na Pluggy, mas houve erro ao registrar no FinTrack. Tente registrar manualmente com o Item ID ' + itemId + '.');
                }
            });
        }

        function salvarConexao() {
            limparErros();
            $('#btnSalvarConexao').prop('disabled', true);

            $.ajax({
                url: '/App/Configuracoes/Pluggy?handler=SalvarConexao',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                data: JSON.stringify({
                    clientId: $('#clientId').val(),
                    clientSecret: $('#clientSecret').val()
                }),
                success: function () {
                    window.location.reload();
                },
                error: function (xhr) {
                    $('#btnSalvarConexao').prop('disabled', false);
                    mostrarErros(xhr);
                }
            });
        }

        function abrirModalItem() {
            limparErros();
            $('#itemId').val('');
            modalItem.show();
        }

        function registrarItem() {
            limparErros();
            $('#btnRegistrarItem').prop('disabled', true);

            $.ajax({
                url: '/App/Configuracoes/Pluggy?handler=RegistrarItem',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                data: JSON.stringify({ itemId: $('#itemId').val() }),
                success: function () {
                    window.location.reload();
                },
                error: function (xhr) {
                    $('#btnRegistrarItem').prop('disabled', false);
                    mostrarErros(xhr);
                }
            });
        }

        function executarImportacao($btn, handler, textoCarregando) {
            const textoOriginal = $btn.text();
            $btn.prop('disabled', true).text(textoCarregando);

            $.ajax({
                url: '/App/Configuracoes/Pluggy?handler=' + handler,
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                data: JSON.stringify({ pluggyItemId: $btn.data('id') }),
                success: function (response) {
                    var aviso = response.atualizacaoSolicitada
                        ? 'Atualização solicitada à Pluggy — pode não ter efeito no Meu Pluggy (a atualização de verdade dele é diária/automática, ou manual em meu.pluggy.ai). Se já havia dados novos, eles já foram lidos agora.'
                        : '';
                    alert(response.novasTransacoes + ' transação(ões) nova(s). ' + response.investimentosSincronizados + ' investimento(s) sincronizado(s).' + (aviso ? '\n' + aviso : ''));
                    window.location.reload();
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).text(textoOriginal);
                    if (xhr.status === 400 && xhr.responseJSON && xhr.responseJSON.mensagem) {
                        alert(xhr.responseJSON.mensagem);
                    } else {
                        alert('Erro ao importar transações.');
                    }
                }
            });
        }

        $(document).on('click', '.btn-buscar', function () {
            executarImportacao($(this), 'Buscar', 'Buscando...');
        });

        $(document).on('click', '.btn-atualizar', function () {
            executarImportacao($(this), 'Atualizar', 'Atualizando...');
        });

        $(document).on('click', '.btn-excluir', function () {
            var $btn = $(this);
            if (!confirm('Excluir a conexão com ' + $btn.data('nome') + '? As transações já importadas continuam no seu extrato.')) return;

            $btn.prop('disabled', true).text('Excluindo...');

            $.ajax({
                url: '/App/Configuracoes/Pluggy?handler=ExcluirItem',
                type: 'POST',
                contentType: 'application/json',
                headers: { 'RequestVerificationToken': token() },
                data: JSON.stringify({ pluggyItemId: $btn.data('id') }),
                success: function () {
                    window.location.reload();
                },
                error: function (xhr) {
                    $btn.prop('disabled', false).text('Excluir');
                    if (xhr.status === 400 && xhr.responseJSON && xhr.responseJSON.mensagem) {
                        alert(xhr.responseJSON.mensagem);
                    } else {
                        alert('Erro ao excluir a conexão.');
                    }
                }
            });
        });
    </script>
}
