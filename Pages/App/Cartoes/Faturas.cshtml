@page
@using System.Globalization
@using Microsoft.AspNetCore.Http
@using FinTrack.Data
@using FinTrack.Models
@using Microsoft.EntityFrameworkCore
@inject FinTrackDbContext Db
@functions {

    public List<FaturaResumo> Faturas { get; set; } = [];

    private int IdUserAtual => HttpContext.Session.GetInt32("IdUser")!.Value;

    public async Task OnGetAsync()
    {
        var idUser = IdUserAtual;

        // O total/vencimento/fechamento/pagamento vêm de GET /bills da Pluggy
        // — a mesma fonte que o dashboard do meu.pluggy.ai usa —, não de soma
        // de transações locais. As transações abaixo são só pra detalhar o
        // que já foi importado (janela fixa de 90 dias); faturas mais antigas
        // que essa janela têm total certo mas lista de compras vazia.
        var faturasPluggy = await Db.PluggyFaturas
            .Where(f => f.IdUser == idUser)
            .ToListAsync();

        var transacoesCartao = await Db.Transacoes
            .Include(t => t.IdCategoriaNavigation)
            .Where(t => t.IdUser == idUser && t.ContaTipo == "CREDIT")
            .ToListAsync();

        // Pagamentos como eventos soltos: qual fatura cada um quita é decidido
        // no cálculo, pelas datas — ver Data/FaturaCalculadora.cs.
        var pagamentos = await Db.PluggyFaturaPagamentos
            .Where(p => p.IdUser == idUser)
            .ToListAsync();

        // Cálculo compartilhado com a página Cartões — as duas têm que
        // mostrar exatamente os mesmos números.
        Faturas = FaturaCalculadora.Calcular(faturasPluggy, transacoesCartao, pagamentos, DateTime.Today);
    }
}
@{
    ViewData["Title"] = "Faturas";
    var culturaBr = new CultureInfo("pt-BR");
}

<h1 class="font-display fs-2 fw-bold text-dark mb-0">Faturas</h1>
<p class="text-secondary mt-1">Valores vindos direto da Pluggy — os mesmos do Meu Pluggy</p>

<div class="alert alert-secondary py-2 px-3 small mt-3 mb-0">
    Cada fatura é um ciclo de fechamento do cartão. O pagamento entra na fatura fechada mais recente que ainda
    tinha saldo — o que sobra vira adiantamento do ciclo seguinte, e o banco já desconta isso do valor da
    próxima fatura. Faturas marcadas como <strong>prevista</strong> ainda não foram fechadas pelo banco:
    o valor é a soma do que já foi lançado nelas.
</div>

<div class="d-grid gap-3 mt-3">
    @foreach (var fatura in Faturas)
    {
        var (textoStatus, classeStatus) = fatura.StatusPagamento is { Length: > 0 } s ? FaturaCalculadora.BadgeStatusPagamento(s) : ("", "");

        <details class="card shadow-sm" open="@(fatura.Estado == EstadoFatura.Aberta ? "open" : null)">
            <summary class="card-header bg-white d-flex align-items-center justify-content-between flex-wrap gap-2" style="cursor: pointer;">
                <span class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="fw-semibold">@fatura.ContaNome</span>
                    <span class="text-secondary">·</span>
                    <span>Vencimento @fatura.DataVencimento.ToString("dd/MM/yyyy")</span>

                    @switch (fatura.Estado)
                    {
                        case EstadoFatura.Aberta:
                            <span class="badge text-bg-primary">Em aberto</span>
                            <span class="text-secondary small">fecha @fatura.DataFechamento.ToString("dd/MM")</span>
                            break;

                        case EstadoFatura.Futura:
                            <span class="badge text-bg-light border text-secondary">Futura</span>
                            break;

                        default:
                            <span class="badge text-bg-light border">Fechada</span>
                            <span class="badge @classeStatus">@textoStatus</span>
                            @if (fatura.EmAtraso)
                            {
                                <span class="badge text-bg-danger">Vencida</span>
                            }
                            @if (fatura.ValorMinimo is decimal minimo && minimo > 0)
                            {
                                <span class="text-secondary small">(mínimo @minimo.ToString("C", culturaBr))</span>
                            }
                            break;
                    }

                    @if (!fatura.TemFaturaOficial)
                    {
                        <span class="badge text-bg-light border text-secondary">prevista</span>
                    }
                </span>
                <span class="fw-bold text-danger">@fatura.ValorTotal.ToString("C", culturaBr)</span>
            </summary>

            @if (fatura.ValorAntecipado > 0 || fatura.ValorPago > 0)
            {
                <div class="px-3 py-2 small border-bottom bg-light-subtle">
                    <span class="text-secondary">Compras: @fatura.ValorCompras.ToString("C", culturaBr)</span>
                    @if (fatura.ValorAntecipado > 0)
                    {
                        <span class="text-success ms-2">− Adiantado no ciclo: @fatura.ValorAntecipado.ToString("C", culturaBr)</span>
                    }
                    <span class="fw-semibold ms-2">= Fatura: @fatura.ValorTotal.ToString("C", culturaBr)</span>
                    @if (fatura.ValorPago > 0)
                    {
                        <span class="text-success ms-2">− Pago: @fatura.ValorPago.ToString("C", culturaBr)</span>
                        <span class="fw-semibold ms-2">= Falta: @fatura.SaldoRestante.ToString("C", culturaBr)</span>
                    }
                </div>
                <table class="table table-sm align-middle mb-0 border-bottom">
                    <tbody>
                        @* O rótulo vem de qual lista o pagamento veio, não de comparar
                           valores: adiantamento e pagamento podem coincidir em data e
                           valor, e aí um Contains marcaria os dois iguais. *@
                        @foreach (var (pagamento, adiantado) in
                            fatura.Adiantamentos.Select(p => (p, true))
                                .Concat(fatura.Pagamentos.Select(p => (p, false)))
                                .OrderBy(x => x.Item1.Data))
                        {
                            <tr>
                                <td class="text-secondary" style="width: 110px;">@pagamento.Data.ToString("dd/MM/yyyy")</td>
                                <td>@(adiantado ? "Pagamento adiantado (antes do fechamento)" : "Pagamento da fatura")</td>
                                <td class="text-end text-success fw-semibold" style="width: 140px;">+ @pagamento.Valor.ToString("C", culturaBr)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            <div class="table-responsive">
                @if (fatura.Transacoes.Count == 0)
                {
                    <p class="text-secondary small text-center py-3 mb-0 px-3">
                        Nenhuma transação desse período foi importada ainda (a sincronização só traz os últimos 90 dias) —
                        o valor da fatura acima é o real da Pluggy, só a lista de compras que está incompleta.
                    </p>
                }
                else
                {
                    <table class="table table-sm align-middle mb-0">
                        <tbody>
                            @foreach (var transacao in fatura.Transacoes)
                            {
                                var despesa = transacao.IdCategoriaNavigation.Tipo;
                                <tr>
                                    <td class="text-secondary" style="width: 110px;">@transacao.Data.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        @(transacao.MerchantNome ?? transacao.Desc)
                                        @if (transacao.PluggyParcelaTotal is int total && total > 1)
                                        {
                                            <span class="badge text-bg-light border ms-1">parcela @transacao.PluggyParcelaAtual/@total</span>
                                        }
                                    </td>
                                    <td class="text-end fw-semibold @(despesa ? "text-danger" : "text-success")" style="width: 140px;">
                                        @((despesa ? "- " : "+ "))@transacao.Valor.ToString("C", culturaBr)
                                        @if (transacao.MoedaOriginalCodigo is not null)
                                        {
                                            <div class="small text-secondary fw-normal">@transacao.MoedaOriginalCodigo @transacao.ValorMoedaOriginal?.ToString("N2", culturaBr)</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (fatura.DivergeDoTotal)
                    {
                        <p class="text-secondary small px-3 py-2 mb-0 border-top">
                            As compras importadas somam @fatura.ValorCompras.ToString("C", culturaBr)
                            @if (fatura.ValorAntecipado > 0)
                            {
                                <text>(− @fatura.ValorAntecipado.ToString("C", culturaBr) adiantados)</text>
                            }
                            , diferente do total oficial da fatura (@fatura.ValorTotal.ToString("C", culturaBr)) —
                            pode faltar alguma compra fora da janela de importação de 90 dias, ou a fatura inclui
                            encargos (multa, juros, IOF) que não vêm como transação separada.
                        </p>
                    }
                }
            </div>
        </details>
    }
    @if (Faturas.Count == 0)
    {
        <div class="card shadow-sm">
            <div class="card-body text-secondary small text-center py-4">
                Nenhuma fatura sincronizada ainda. Clique em Buscar/Atualizar em
                <a asp-page="/App/Configuracoes/Pluggy" class="text-decoration-none">Meu Pluggy</a> pra importar.
            </div>
        </div>
    }
</div>
